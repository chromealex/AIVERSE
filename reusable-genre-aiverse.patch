+    if(root.has("projectile")) { const auto& section=root["projectile"];
+        if(!section.isObject()) result.errors.push_back("projectile: expected object");
+        else {
+            for(const auto& entry:section.members()) if(entry.first!="gravityMilli" && entry.first!="radiusMilli" && entry.first!="retentionMilli" && entry.first!="lifetime" && entry.first!="maxBounces") result.errors.push_back("projectile."+entry.first+": unknown field");
+            if(section.has("gravityMilli")) number(section["gravityMilli"],settings.projectile.gravityMilli,0,1000000,"projectile.gravityMilli");
+            if(section.has("radiusMilli")) number(section["radiusMilli"],settings.projectile.radiusMilli,0,2000,"projectile.radiusMilli");
+            if(section.has("retentionMilli")) number(section["retentionMilli"],settings.projectile.retentionMilli,0,1000,"projectile.retentionMilli");
+            if(section.has("lifetime")) number(section["lifetime"],settings.projectile.lifetime,1,100000,"projectile.lifetime");
+            if(section.has("maxBounces")) number(section["maxBounces"],settings.projectile.maxBounces,0,32,"projectile.maxBounces");
+        }
+    }
+    if(root.has("matchRules")) { const auto& section=root["matchRules"];
+        if(!section.isObject()) result.errors.push_back("matchRules: expected object");
+        else {
+            for(const auto& entry:section.members()) if(entry.first!="warmupTicks" && entry.first!="roundTicks" && entry.first!="overtimeTicks" && entry.first!="intermissionTicks" && entry.first!="roundsToWin" && entry.first!="maxRounds" && entry.first!="scoreToWin") result.errors.push_back("matchRules."+entry.first+": unknown field");
+            if(section.has("warmupTicks")) number(section["warmupTicks"],settings.matchRules.warmupTicks,0,10000000,"matchRules.warmupTicks");
+            if(section.has("roundTicks")) number(section["roundTicks"],settings.matchRules.roundTicks,1,10000000,"matchRules.roundTicks");
+            if(section.has("overtimeTicks")) number(section["overtimeTicks"],settings.matchRules.overtimeTicks,0,10000000,"matchRules.overtimeTicks");
+            if(section.has("intermissionTicks")) number(section["intermissionTicks"],settings.matchRules.intermissionTicks,0,10000000,"matchRules.intermissionTicks");
+            if(section.has("roundsToWin")) number(section["roundsToWin"],settings.matchRules.roundsToWin,1,100,"matchRules.roundsToWin");
+            if(section.has("maxRounds")) number(section["maxRounds"],settings.matchRules.maxRounds,1,1000,"matchRules.maxRounds");
+            if(section.has("scoreToWin")) number(section["scoreToWin"],settings.matchRules.scoreToWin,1,1000000000,"matchRules.scoreToWin");
+        }
+        if(settings.matchRules.roundsToWin>settings.matchRules.maxRounds)result.errors.push_back("matchRules.roundsToWin: must not exceed maxRounds");
+    }
     if(result.errors.empty()) result.value=settings;
     return result;
 }

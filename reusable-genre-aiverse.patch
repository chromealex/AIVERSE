index 0000000..e9fed25
--- /dev/null
+++ b/libraries/include/aiverselib/genre/Persistence.h
@@ -0,0 +1,47 @@
+#pragma once
+#include "Locomotion.h"
+#include "Melee.h"
+#include "Weapons.h"
+#include "Match.h"
+#include "Narrative.h"
+#include "engine/core/Archive.h"
+#include "../runtime/NativeBytes.h"
+namespace aiverse::lib::genre {
+inline void io(Archive& a,MotionState& s){a(s.velocity,s.lastTick,s.lastGround,s.jumpTick,s.jumps,s.initialized,s.hasGround,s.buffered);}
+inline void io(Archive& a,MeleeState& s){a(s.attack,s.queued,s.started,s.queuedAt,s.lastTick,s.initialized,s.hitTargets);}
+inline void io(Archive& a,RecoilState& s){a(s.yaw,s.pitch);}
+inline void io(Archive& a,ProjectileState& s){a(s.position,s.velocity,s.age,s.bounces,s.alive);}
+inline void io(Archive& a,TeamScore& s){a(s.score,s.wins,s.lastEvent);}
+inline void io(Archive& a,MatchState& s){a(s.teams,s.phase,s.phaseStart,s.lastTick,s.round,s.winner,s.initialized);}
+inline void io(Archive& a,CaptureState& s){a(s.owner,s.candidate,s.progress,s.lastTick,s.initialized);}
+inline void io(Archive& a,StoryState& s){a(s.node,s.facts,s.visits,s.lastCommand,s.complete);}
+inline bool bounded(Vec3 p,Fixed maximum){return p.x>= -maximum&&p.x<=maximum&&p.y>= -maximum&&p.y<=maximum&&p.z>= -maximum&&p.z<=maximum;}
+inline bool valid(const MotionState& s){return bounded(s.velocity,1000_fx)&&s.jumps<=16&&(!s.hasGround||s.lastGround<=s.lastTick)&&(!s.buffered||s.jumpTick<=s.lastTick);}
+inline bool valid(const MeleeState& s){return s.attack>=0&&s.queued>=0&&s.started<=s.lastTick&&s.queuedAt<=s.lastTick&&s.hitTargets.size()<=4096&&std::is_sorted(s.hitTargets.begin(),s.hitTargets.end())&&std::adjacent_find(s.hitTargets.begin(),s.hitTargets.end())==s.hitTargets.end()&&(s.hitTargets.empty()||s.hitTargets.front()>0);}
+inline bool valid(const RecoilState& s){return s.yaw>=Fixed::fromRatio(-1,4)&&s.yaw<=Fixed::fromRatio(1,4)&&s.pitch>=Fixed::fromRatio(-1,4)&&s.pitch<=Fixed::fromRatio(1,4);}
+inline bool valid(const ProjectileState& s){return bounded(s.position,100000_fx)&&bounded(s.velocity,1000_fx)&&s.age<=100000&&s.bounces<=32;}
+inline bool valid(const MatchState& s){
+    if(s.teams.size()<2||s.teams.size()>200||uint8_t(s.phase)>uint8_t(MatchPhase::Finished)||s.phaseStart>s.lastTick||!s.round||s.round>1000||(s.winner>0&&!s.teams.contains(s.winner))||s.winner< -1)return false;
+    for(auto [team,score]:s.teams)if(team<=0||score.score<0||score.wins>1000)return false;return true;
+}
+inline bool valid(const CaptureState& s){return s.owner>=0&&s.candidate>=0&&s.progress<=10000000;}
+inline bool valid(const StoryState& s){
+    if(s.node<0||s.facts.size()>10000||s.visits.size()>10000||(s.complete&&s.node!=0))return false;
+    for(auto [key,value]:s.facts){(void)value;if(key<=0)return false;}for(auto [key,value]:s.visits)if(key<=0||value<1)return false;return true;
+}
+inline uint16_t stateKind(const MotionState&){return 1;}
+inline uint16_t stateKind(const MeleeState&){return 2;}
+inline uint16_t stateKind(const RecoilState&){return 3;}
+inline uint16_t stateKind(const ProjectileState&){return 4;}
+inline uint16_t stateKind(const MatchState&){return 5;}
+inline uint16_t stateKind(const CaptureState&){return 6;}
+inline uint16_t stateKind(const StoryState&){return 7;}
+template<class State> std::string save(State s){
+    if(!valid(s))return {};std::string bytes;Archive a(&bytes);uint32_t version=1;auto kind=stateKind(s);a(version,kind,s);return bytes;
+}
+template<class State> bool load(const std::string& bytes,State& state){
+    if(bytes.size()>1024*1024)return false;Archive a(bytes);uint32_t version=0;uint16_t kind=0;State copy;a(version,kind);if(version!=1||kind!=stateKind(copy))return false;a(copy);
+    if(!a.ok()||a.remaining()||version!=1||!valid(copy)||save(copy)!=bytes)return false;state=std::move(copy);return true;
+}
+using runtime::storeBytes;using runtime::loadBytes;
+}
diff --git a/libraries/include/aiverselib/genre/Weapons.h b/libraries/include/aiverselib/genre/Weapons.h
new file mode 100644
index 0000000..e1802df
--- /dev/null
+++ b/libraries/include/aiverselib/genre/Weapons.h
@@ -0,0 +1,41 @@
+#pragma once
+#include "engine/core/FixedMath.h"
+#include "engine/core/Random.h"
+#include "engine/world/SpatialWorld.h"
+#include <optional>
+namespace aiverse::lib::genre {
+struct RecoilConfig {Fixed yawImpulse=Fixed::fromRatio(1,1000),pitchImpulse=Fixed::fromRatio(1,100),recovery=Fixed::fromRatio(1,1000),maximum=Fixed::fromRatio(1,8);};
+struct RecoilState {Fixed yaw{},pitch{};};
+inline bool stepRecoil(const RecoilConfig& c,RecoilState& s,bool fired){
+    if(c.maximum<Fixed{}||c.maximum>Fixed::fromRatio(1,4)||c.recovery<Fixed{}||c.recovery>c.maximum||c.yawImpulse< -c.maximum||c.yawImpulse>c.maximum||c.pitchImpulse< -c.maximum||c.pitchImpulse>c.maximum)return false;
+    auto recover=[&](Fixed value){return value-fxClamp(value,-c.recovery,c.recovery);};
+    s.yaw=fxClamp(recover(s.yaw)+(fired?c.yawImpulse:Fixed{}),-c.maximum,c.maximum);
+    s.pitch=fxClamp(recover(s.pitch)+(fired?c.pitchImpulse:Fixed{}),-c.maximum,c.maximum);return true;
+}
+inline std::optional<Vec2> sampleSpread(Random& rng,Fixed halfAngle){
+    if(halfAngle<Fixed{}||halfAngle>Fixed::fromRatio(1,8))return {};if(!halfAngle.raw)return Vec2{};
+    auto sample=[&]{return Fixed::fromRaw(int64_t(rng.below(uint32_t(halfAngle.raw*2+1)))-halfAngle.raw);};return Vec2{sample(),sample()};
+}
+struct ProjectileConfig {Fixed gravity=20_fx,radius=Fixed::fromRatio(1,20),retention=Fixed::fromRatio(3,4);uint32_t lifetime=600,maxBounces=0;};
+struct ProjectileState {Vec3 position{},velocity{};uint32_t age=0,bounces=0;bool alive=true;};
+struct ProjectileImpact {uint32_t collider=0;Vec3 point{},normal{};bool bounced=false;};
+struct ProjectileStep {bool accepted=false;std::optional<ProjectileImpact> impact;};
+inline ProjectileStep stepProjectile(const ProjectileConfig& c,ProjectileState& state,const world::SpatialWorld& world,Fixed dt){
+    if(!state.alive||dt<=Fixed{}||dt>1_fx||c.gravity<Fixed{}||c.gravity>1000_fx||c.radius<Fixed{}||c.radius>2_fx||c.retention<Fixed{}||c.retention>1_fx||c.lifetime==0||c.lifetime>100000||c.maxBounces>32)return {};
+    for(auto value:{state.position.x,state.position.y,state.position.z})if(value< -100000_fx||value>100000_fx)return {};
+    for(auto value:{state.velocity.x,state.velocity.y,state.velocity.z})if(value< -1000_fx||value>1000_fx)return {};
+    if(state.bounces>32||state.age>100000)return {};
+    auto s=state;
+    if(s.age>=c.lifetime){s.alive=false;state=s;return {true,{}};}
+    s.velocity.y=fxMax(s.velocity.y-c.gravity*dt,-1000_fx);auto delta=s.velocity*dt;
+    auto hit=world.cast(s.position,delta,{c.radius,c.radius,c.radius});std::optional<ProjectileImpact> impact;
+    if(hit.hit){s.position+=delta*hit.fraction;bool bounce=s.bounces<c.maxBounces&&hit.normal.lengthSq()>Fixed{}&&s.velocity.dot(hit.normal)<Fixed{};
+        impact=ProjectileImpact{hit.id,s.position,hit.normal,bounce};
+        if(bounce){++s.bounces;s.velocity=(s.velocity-hit.normal*(s.velocity.dot(hit.normal)*2))*c.retention;s.position+=hit.normal*Fixed::fromRatio(1,1000);}else s.alive=false;
+    }else s.position+=delta;
+    for(auto* value:{&s.position.x,&s.position.y,&s.position.z})if(*value< -100000_fx||*value>100000_fx){*value=fxClamp(*value,-100000_fx,100000_fx);s.alive=false;}
+    ++s.age;if(s.age>=c.lifetime)s.alive=false;state=s;return {true,impact};
+}
+// At most one impact per tick; unspent travel after a ricochet is discarded deliberately.
+// Damage, ownership, ammo/cooldowns and spawn commands stay with the existing combat owner.
+}
diff --git a/libraries/include/aiverselib/runtime/NativeBytes.h b/libraries/include/aiverselib/runtime/NativeBytes.h
new file mode 100644
index 0000000..3fe5d31
--- /dev/null
+++ b/libraries/include/aiverselib/runtime/NativeBytes.h
@@ -0,0 +1,20 @@
+#pragma once
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <vector>
+namespace aiverse::lib::runtime {
+// NativeState-compatible arrays for an existing versioned binary codec.
+template<class NativeState>
+bool storeBytes(NativeState& state,const std::string& key,const std::string& bytes){
+    if(bytes.empty()||bytes.size()>16*1024*1024)return false;
+    std::vector<int64_t> values;values.reserve(bytes.size()+1);values.push_back(1);
+    for(unsigned char byte:bytes)values.push_back(byte);state.arrays[key]=std::move(values);return true;
+}
+template<class NativeState>
+std::optional<std::string> loadBytes(const NativeState& state,const std::string& key){
+    auto it=state.arrays.find(key);if(it==state.arrays.end()||it->second.size()<2||it->second.size()>16*1024*1024+1||it->second[0]!=1)return {};
+    std::string bytes;bytes.reserve(it->second.size()-1);
+    for(size_t i=1;i<it->second.size();++i){auto byte=it->second[i];if(byte<0||byte>255)return {};bytes.push_back(char(byte));}return bytes;
+}
+}

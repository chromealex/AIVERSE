+    }
+    const auto arrival=navigation?fxMin(navigation->config.cellSize/8,Fixed::fromRatio(1,10)):c.arrivalRadius;
+    if(goal&&(self.pos-*goal).xz().length()>arrival){
+        auto wish=fxNormalize(flat(*goal-self.pos));

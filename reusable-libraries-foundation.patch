+using runtime::storeBytes;using runtime::loadBytes;
+}
diff --git a/libraries/include/rtslib/genre/Weapons.h b/libraries/include/rtslib/genre/Weapons.h
new file mode 100644
index 00000000..02eb3762
--- /dev/null
+++ b/libraries/include/rtslib/genre/Weapons.h
@@ -0,0 +1,41 @@
+#pragma once
+#include "engine/core/FixedMath.h"
+#include "engine/core/Random.h"
+#include "engine/world/SpatialWorld.h"
+#include <optional>
+namespace rts::lib::genre {
+struct RecoilConfig {Fixed yawImpulse=Fixed::fromRatio(1,1000),pitchImpulse=Fixed::fromRatio(1,100),recovery=Fixed::fromRatio(1,1000),maximum=Fixed::fromRatio(1,8);};
+struct RecoilState {Fixed yaw{},pitch{};};
+inline bool stepRecoil(const RecoilConfig& c,RecoilState& s,bool fired){
+    if(c.maximum<Fixed{}||c.maximum>Fixed::fromRatio(1,4)||c.recovery<Fixed{}||c.recovery>c.maximum||c.yawImpulse< -c.maximum||c.yawImpulse>c.maximum||c.pitchImpulse< -c.maximum||c.pitchImpulse>c.maximum)return false;
+    auto recover=[&](Fixed value){return value-fxClamp(value,-c.recovery,c.recovery);};
+    s.yaw=fxClamp(recover(s.yaw)+(fired?c.yawImpulse:Fixed{}),-c.maximum,c.maximum);
+    s.pitch=fxClamp(recover(s.pitch)+(fired?c.pitchImpulse:Fixed{}),-c.maximum,c.maximum);return true;
+}
+inline std::optional<Vec2> sampleSpread(Random& rng,Fixed halfAngle){
+    if(halfAngle<Fixed{}||halfAngle>Fixed::fromRatio(1,8))return {};if(!halfAngle.raw)return Vec2{};
+    auto sample=[&]{return Fixed::fromRaw(int64_t(rng.below(uint32_t(halfAngle.raw*2+1)))-halfAngle.raw);};return Vec2{sample(),sample()};
+}
+struct ProjectileConfig {Fixed gravity=20_fx,radius=Fixed::fromRatio(1,20),retention=Fixed::fromRatio(3,4);uint32_t lifetime=600,maxBounces=0;};
+struct ProjectileState {Vec3 position{},velocity{};uint32_t age=0,bounces=0;bool alive=true;};
+struct ProjectileImpact {uint32_t collider=0;Vec3 point{},normal{};bool bounced=false;};
+struct ProjectileStep {bool accepted=false;std::optional<ProjectileImpact> impact;};
+inline ProjectileStep stepProjectile(const ProjectileConfig& c,ProjectileState& state,const world::SpatialWorld& world,Fixed dt){
+    if(!state.alive||dt<=Fixed{}||dt>1_fx||c.gravity<Fixed{}||c.gravity>1000_fx||c.radius<Fixed{}||c.radius>2_fx||c.retention<Fixed{}||c.retention>1_fx||c.lifetime==0||c.lifetime>100000||c.maxBounces>32)return {};
+    for(auto value:{state.position.x,state.position.y,state.position.z})if(value< -100000_fx||value>100000_fx)return {};
+    for(auto value:{state.velocity.x,state.velocity.y,state.velocity.z})if(value< -1000_fx||value>1000_fx)return {};
+    if(state.bounces>32||state.age>100000)return {};
+    auto s=state;
+    if(s.age>=c.lifetime){s.alive=false;state=s;return {true,{}};}
+    s.velocity.y=fxMax(s.velocity.y-c.gravity*dt,-1000_fx);auto delta=s.velocity*dt;
+    auto hit=world.cast(s.position,delta,{c.radius,c.radius,c.radius});std::optional<ProjectileImpact> impact;
+    if(hit.hit){s.position+=delta*hit.fraction;bool bounce=s.bounces<c.maxBounces&&hit.normal.lengthSq()>Fixed{}&&s.velocity.dot(hit.normal)<Fixed{};
+        impact=ProjectileImpact{hit.id,s.position,hit.normal,bounce};
+        if(bounce){++s.bounces;s.velocity=(s.velocity-hit.normal*(s.velocity.dot(hit.normal)*2))*c.retention;s.position+=hit.normal*Fixed::fromRatio(1,1000);}else s.alive=false;
+    }else s.position+=delta;
+    for(auto* value:{&s.position.x,&s.position.y,&s.position.z})if(*value< -100000_fx||*value>100000_fx){*value=fxClamp(*value,-100000_fx,100000_fx);s.alive=false;}
+    ++s.age;if(s.age>=c.lifetime)s.alive=false;state=s;return {true,impact};
+}
+// At most one impact per tick; unspent travel after a ricochet is discarded deliberately.
+// Damage, ownership, ammo/cooldowns and spawn commands stay with the existing combat owner.
+}
diff --git a/libraries/include/rtslib/runtime/Bounded.h b/libraries/include/rtslib/runtime/Bounded.h
new file mode 100644
index 00000000..e089d768
--- /dev/null
+++ b/libraries/include/rtslib/runtime/Bounded.h
@@ -0,0 +1,34 @@
+#pragma once
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+#include <optional>
+#include <span>
+#include <utility>
+namespace rts::lib::runtime {
+template<class T,std::size_t N> class ScratchBuffer {
+    std::array<T,N> items_{};
+    std::size_t size_=0;
+public:
+    bool push(T value){if(size_==N)return false;items_[size_++]=std::move(value);return true;}
+    void clear(){for(std::size_t i=0;i<size_;++i)items_[i]=T{};size_=0;}
+    std::span<const T> values()const{return {items_.data(),size_};}
+    std::size_t size()const{return size_;}
+};
+struct PoolHandle {std::size_t index=0;std::uint64_t generation=0;};
+// Fixed slots, lowest free index wins. A wrapped slot is retired instead of aliasing stale handles.
+template<class T,std::size_t N> class SlotPool {
+    std::array<std::optional<T>,N> slots_{};
+    std::array<std::uint64_t,N> generations_{};
+public:
+    std::optional<PoolHandle> acquire(T value){
+        for(std::size_t i=0;i<N;++i)if(!slots_[i]&&generations_[i]!=std::numeric_limits<std::uint64_t>::max()){
+            slots_[i]=std::move(value);return PoolHandle{i,++generations_[i]};
+        }
+        return std::nullopt;
+    }
+    T* get(PoolHandle h){return h.index<N&&h.generation!=0&&generations_[h.index]==h.generation&&slots_[h.index]?&*slots_[h.index]:nullptr;}
+    bool release(PoolHandle h){if(!get(h))return false;slots_[h.index].reset();return true;}
+};
+}
diff --git a/libraries/include/rtslib/runtime/HotReload.h b/libraries/include/rtslib/runtime/HotReload.h
new file mode 100644
index 00000000..073a714f
--- /dev/null
+++ b/libraries/include/rtslib/runtime/HotReload.h
@@ -0,0 +1,29 @@
+#pragma once
+#include <cstdint>
+#include <limits>
+#include <optional>
+#include <utility>
+namespace rts::lib::runtime {
+// Presentation/tool settings only. Gameplay config changes must be replicated Commands.
+template<class T> class HotReload {
+    T live_;
+    std::optional<T> pending_;
+    std::uint64_t revision_=0;
+public:
+    explicit HotReload(T initial):live_(std::move(initial)){}
+    const T& current()const{return live_;}
+    std::uint64_t revision()const{return revision_;}
+    template<class Parse,class Validate,class Input>
+    bool stage(const Input& input,Parse parse,Validate validate){
+        pending_.reset();
+        auto candidate=parse(input);
+        if(!candidate||!validate(*candidate)){pending_.reset();return false;}
+        pending_=std::move(*candidate);return true;
+    }
+    bool commit(bool safePoint,std::uint64_t expectedRevision){
+        if(!safePoint||expectedRevision!=revision_||!pending_||revision_==std::numeric_limits<std::uint64_t>::max())return false;
+        live_=std::move(*pending_);pending_.reset();++revision_;return true;
+    }
+    void cancel(){pending_.reset();}
+};
+}
diff --git a/libraries/include/rtslib/runtime/NativeBytes.h b/libraries/include/rtslib/runtime/NativeBytes.h
new file mode 100644
index 00000000..1d1885d9
--- /dev/null
+++ b/libraries/include/rtslib/runtime/NativeBytes.h
@@ -0,0 +1,20 @@
+#pragma once
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <vector>
+namespace rts::lib::runtime {
+// NativeState-compatible arrays for an existing versioned binary codec.
+template<class NativeState>
+bool storeBytes(NativeState& state,const std::string& key,const std::string& bytes){
+    if(bytes.empty()||bytes.size()>16*1024*1024)return false;
+    std::vector<int64_t> values;values.reserve(bytes.size()+1);values.push_back(1);
+    for(unsigned char byte:bytes)values.push_back(byte);state.arrays[key]=std::move(values);return true;
+}
+template<class NativeState>
+std::optional<std::string> loadBytes(const NativeState& state,const std::string& key){
+    auto it=state.arrays.find(key);if(it==state.arrays.end()||it->second.size()<2||it->second.size()>16*1024*1024+1||it->second[0]!=1)return {};
+    std::string bytes;bytes.reserve(it->second.size()-1);
+    for(size_t i=1;i<it->second.size();++i){auto byte=it->second[i];if(byte<0||byte>255)return {};bytes.push_back(char(byte));}return bytes;
+}
+}
diff --git a/libraries/include/rtslib/runtime/NativeTrace.h b/libraries/include/rtslib/runtime/NativeTrace.h
new file mode 100644
index 00000000..cc24b729
--- /dev/null
+++ b/libraries/include/rtslib/runtime/NativeTrace.h
@@ -0,0 +1,21 @@
+#pragma once
+#include "engine/data/Json.h"
+#include <map>
+#include <optional>
+#include <string>
+namespace rts::lib::runtime {
+// Host diagnostic adapter. State is NativeState-compatible; names come from the project's module registry.
+// Never call while another thread mutates the referenced states.
+template<class State>
+std::optional<rts::Json> nativeTrace(std::int64_t tick,const std::map<std::string,const State*>& states){
+    if(tick<0)return {};
+    auto modules=rts::Json::object();
+    for(const auto& [name,state]:states){
+        if(name.empty()||!state)return {};
+        auto values=rts::Json::object();for(const auto& [key,value]:state->values)values.set(key,rts::Json::number(value));
+        auto arrays=rts::Json::object();for(const auto& [key,data]:state->arrays){auto array=rts::Json::array();for(auto value:data)array.push(rts::Json::number(value));arrays.set(key,std::move(array));}
+        auto module=rts::Json::object();module.set("values",std::move(values));module.set("arrays",std::move(arrays));modules.set(name,std::move(module));
+    }
+    auto row=rts::Json::object();row.set("tick",rts::Json::number(tick));row.set("modules",std::move(modules));return row;
+}
+}
diff --git a/libraries/include/rtslib/runtime/StateDiff.h b/libraries/include/rtslib/runtime/StateDiff.h
new file mode 100644
index 00000000..780ef842
--- /dev/null
+++ b/libraries/include/rtslib/runtime/StateDiff.h
@@ -0,0 +1,37 @@
+#pragma once
+#include <cstdint>
+#include <map>
+#include <optional>
+#include <string>
+#include <vector>
+namespace rts::lib::runtime {
+struct StateDifference {std::string field;std::optional<std::int64_t> expected,actual;std::string reason="value";};
+// NativeState-compatible adapter. Compare canonical ordered values, not hash collisions.
+template<class State>
+std::optional<StateDifference> firstStateDifference(const State& a,const State& b){
+    auto values=[](const auto& left,const auto& right)->std::optional<StateDifference>{
+        auto x=left.begin(),y=right.begin();
+        while(x!=left.end()||y!=right.end()){
+            if(y==right.end()||(x!=left.end()&&x->first<y->first))return StateDifference{"values/"+x->first,x->second,{}};
+            if(x==left.end()||y->first<x->first)return StateDifference{"values/"+y->first,{},y->second};
+            if(x->second!=y->second)return StateDifference{"values/"+x->first,x->second,y->second};
+            ++x;++y;
+        }
+        return {};
+    };
+    if(auto d=values(a.values,b.values))return d;
+    auto x=a.arrays.begin(),y=b.arrays.begin();
+    while(x!=a.arrays.end()||y!=b.arrays.end()){
+        if(y==b.arrays.end()||(x!=a.arrays.end()&&x->first<y->first))return StateDifference{"arrays/"+x->first,{},{},"missing actual array"};
+        if(x==a.arrays.end()||y->first<x->first)return StateDifference{"arrays/"+y->first,{},{},"missing expected array"};
+        const auto& l=x->second;const auto& r=y->second;
+        for(std::size_t i=0;i<l.size()||i<r.size();++i){
+            auto lv=i<l.size()?std::optional<std::int64_t>(l[i]):std::nullopt;
+            auto rv=i<r.size()?std::optional<std::int64_t>(r[i]):std::nullopt;
+            if(lv!=rv)return StateDifference{"arrays/"+x->first+"/"+std::to_string(i),lv,rv};
+        }
+        ++x;++y;
+    }
+    return {};
+}
+}
diff --git a/libraries/include/rtslib/runtime/WorkBudget.h b/libraries/include/rtslib/runtime/WorkBudget.h
new file mode 100644
index 00000000..826790cd
--- /dev/null
+++ b/libraries/include/rtslib/runtime/WorkBudget.h
@@ -0,0 +1,29 @@
+#pragma once
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+#include <span>
+namespace rts::lib::runtime {
+struct WorkItem {std::uint64_t id=0,total=0,completed=0;};
+struct WorkCursor {std::size_t next=0;};
+struct WorkResult {std::size_t operations=0;bool valid=true,blocked=false;};
+// One callback = one bounded operation. No wall-clock budget; persist items/cursor for rollback.
+// Caller supplies sorted unique IDs; callback must not mutate this span/cursor or its backing store.
+template<class Step>
+WorkResult runBudget(std::span<WorkItem> items,WorkCursor& cursor,std::size_t budget,Step step){
+    for(std::size_t i=0;i<items.size();++i)if(items[i].completed>items[i].total||(i&&items[i-1].id>=items[i].id))return {0,false,false};
+    if(items.empty())return {};
+    if(cursor.next>=items.size())return {0,false,false};
+    WorkResult out;
+    std::size_t idle=0;
+    while(out.operations<budget&&idle<items.size()){
+        auto& item=items[cursor.next];
+        if(item.completed<item.total){
+            if(!step(item.id,item.completed)){out.blocked=true;return out;}
+            ++item.completed;++out.operations;idle=0;
+        }else ++idle;
+        cursor.next=(cursor.next+1)%items.size();
+    }
+    return out;
+}
+}

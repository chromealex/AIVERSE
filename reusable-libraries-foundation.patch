diff --git a/libraries/include/rtslib/gameplay/Construction.h b/libraries/include/rtslib/gameplay/Construction.h
new file mode 100644
index 00000000..f38b8d15
--- /dev/null
+++ b/libraries/include/rtslib/gameplay/Construction.h
@@ -0,0 +1,40 @@
+#pragma once
+#include "Diagnostics.h"
+#include <algorithm>
+#include <cstdint>
+#include <limits>
+#include <span>
+#include <vector>
+namespace rts::lib::gameplay {
+struct Cell { std::int64_t x=0,z=0; };
+struct Placement { std::int64_t x=0,z=0,width=1,height=1,rotation=0,owner=0,maxSlope=0; bool requireTerritory=false; };
+struct CellInfo { bool passable=true; std::int64_t owner=0,slope=0,blocker=0; };
+struct Cost { std::int64_t resource=0,amount=0; };
+template<class Inspect>
+Decision checkPlacement(const Placement& p,Inspect inspect) {
+    if(p.width<1||p.height<1||p.width>256||p.height>256||p.rotation<0||p.rotation>3||p.maxSlope<0) return {Reason::Invalid};
+    auto w=p.rotation%2?p.height:p.width, h=p.rotation%2?p.width:p.height;
+    if(p.x>std::numeric_limits<std::int64_t>::max()-w||p.z>std::numeric_limits<std::int64_t>::max()-h) return {Reason::Invalid};
+    for(std::int64_t z=0;z<h;++z) for(std::int64_t x=0;x<w;++x) {
+        auto c=inspect(Cell{p.x+x,p.z+z});
+        if(!c.passable) return {Reason::Blocked,c.blocker};
+        if(p.requireTerritory&&c.owner!=p.owner) return {Reason::Territory,c.owner,p.owner,c.owner};
+        if(c.slope<0||c.slope>p.maxSlope) return {Reason::Slope,0,c.slope,p.maxSlope};
+    }
+    return {};
+}
+template<class Available>
+Decision checkCosts(std::span<const Cost> costs,Available available) {
+    std::vector<Cost> sorted(costs.begin(),costs.end());std::sort(sorted.begin(),sorted.end(),[](auto a,auto b){return a.resource<b.resource;});
+    for(std::size_t i=0;i<sorted.size();) {
+        const auto id=sorted[i].resource;std::int64_t sum=0;
+        while(i<sorted.size()&&sorted[i].resource==id) { auto amount=sorted[i++].amount;if(amount<0||amount>std::numeric_limits<std::int64_t>::max()-sum)return {Reason::Invalid,id};sum+=amount; }
+        auto have=available(id);if(have<sum)return {Reason::Resources,id,sum,have};
+    }
+    return {};
+}
+inline std::int64_t refund(std::int64_t paid,std::int64_t perMille) {
+    if(paid<0||perMille<0||perMille>1000)return 0;
+    return (paid/1000)*perMille+(paid%1000)*perMille/1000;
+}
+}
diff --git a/libraries/include/rtslib/gameplay/Diagnostics.h b/libraries/include/rtslib/gameplay/Diagnostics.h
new file mode 100644
index 00000000..75080619
--- /dev/null
+++ b/libraries/include/rtslib/gameplay/Diagnostics.h
@@ -0,0 +1,40 @@
+#pragma once
+#include <cstddef>
+#include <cstdint>
+#include <deque>
+#include <string_view>
+namespace rts::lib::gameplay {
+enum class Reason { Ok, Invalid, Blocked, Territory, Slope, Resources, Cooldown, Target, Range, Capacity, Busy, Missing, Version, Cancelled };
+struct Decision {
+    Reason reason=Reason::Ok;
+    std::int64_t subject=0, required=0, available=0;
+    explicit operator bool() const { return reason==Reason::Ok; }
+};
+// Keys, not sentences: the host resolves these via Localization::tr and parameters.
+inline std::string_view reasonKey(Reason r) {
+    switch(r) {
+#define RTS_REASON(value,key) case Reason::value:return "library.reason." key;
+        RTS_REASON(Ok,"ok") RTS_REASON(Invalid,"invalid") RTS_REASON(Blocked,"blocked")
+        RTS_REASON(Territory,"territory") RTS_REASON(Slope,"slope") RTS_REASON(Resources,"resources")
+        RTS_REASON(Cooldown,"cooldown") RTS_REASON(Target,"target") RTS_REASON(Range,"range")
+        RTS_REASON(Capacity,"capacity") RTS_REASON(Busy,"busy") RTS_REASON(Missing,"missing")
+        RTS_REASON(Version,"version") RTS_REASON(Cancelled,"cancelled")
+#undef RTS_REASON
+    }
+    return "library.reason.invalid";
+}
+struct TraceEvent { std::int64_t tick=0,actor=0,action=0; Decision decision; };
+class DecisionTrace {
+public:
+    explicit DecisionTrace(std::size_t capacity=128):capacity_(capacity){}
+    void record(TraceEvent event) {
+        if (!capacity_) return;
+        if (events_.size()==capacity_) events_.pop_front();
+        events_.push_back(event);
+    }
+    const std::deque<TraceEvent>& events() const { return events_; }
+    void clear() { events_.clear(); }
+private:
+    std::size_t capacity_; std::deque<TraceEvent> events_;
+};
+}
diff --git a/libraries/include/rtslib/gameplay/Feedback.h b/libraries/include/rtslib/gameplay/Feedback.h
new file mode 100644
index 00000000..8da727de
--- /dev/null
+++ b/libraries/include/rtslib/gameplay/Feedback.h
@@ -0,0 +1,22 @@
+#pragma once
+#include <cstdint>
+#include <map>
+#include <span>
+#include <vector>
+namespace rts::lib::gameplay {
+enum class FeedbackKind { Sound,Particle,Animation,Notification,CameraShake };
+struct FeedbackAction { FeedbackKind kind=FeedbackKind::Sound;std::int64_t asset=0,magnitude=1000; };
+struct FeedbackRule { std::int64_t id=0,event=0,cooldownTicks=0;bool ownOnly=false;std::vector<FeedbackAction> actions; };
+struct FeedbackEvent { std::int64_t type=0,subject=0,tick=0;bool own=true; };
+struct FeedbackState {std::map<std::int64_t,std::int64_t> lastTick;};
+// Presentation state only: clear after rollback/seek. Dispatch only after simulation events are accepted.
+template<class Emit>
+void dispatchFeedback(std::span<const FeedbackRule> rules,FeedbackState& state,const FeedbackEvent& event,Emit emit) {
+    if(event.tick<0)return;
+    for(const auto& r:rules)if(r.event==event.type&&(!r.ownOnly||event.own)&&r.cooldownTicks>=0){
+        auto it=state.lastTick.find(r.id);
+        if(it!=state.lastTick.end()&&(event.tick<it->second||event.tick-it->second<r.cooldownTicks))continue;
+        state.lastTick[r.id]=event.tick;for(const auto& a:r.actions)emit(a,event.subject);
+    }
+}
+}
diff --git a/libraries/include/rtslib/gameplay/Input.h b/libraries/include/rtslib/gameplay/Input.h
new file mode 100644

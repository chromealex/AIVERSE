@@ -0,0 +1,19 @@
+#pragma once
+#include "Tags.h"
+#include "../gameplay/Diagnostics.h"
+#include <algorithm>
+#include <span>
+#include <vector>
+namespace rts::lib::systems {
+struct Interaction {std::int64_t id=0,priority=0;TagQuery targetTags;};
+struct InteractionOption {std::int64_t id=0;gameplay::Decision decision;};
+// Deterministic menu order: descending priority then ascending action ID. Pure previews are advisory.
+template<class Check>
+std::vector<InteractionOption> interactions(std::span<const Interaction> definitions,std::uint64_t tags,Check check){
+    std::vector<Interaction> sorted(definitions.begin(),definitions.end());
+    std::sort(sorted.begin(),sorted.end(),[](const auto& a,const auto& b){return a.id<b.id;});
+    for(std::size_t i=0;i<sorted.size();++i)if(sorted[i].id<=0||(i&&sorted[i-1].id==sorted[i].id))return {};
+    std::sort(sorted.begin(),sorted.end(),[](const auto& a,const auto& b){return a.priority!=b.priority?a.priority>b.priority:a.id<b.id;});
+    std::vector<InteractionOption> result;for(const auto& def:sorted)if(matches(tags,def.targetTags))result.push_back({def.id,check(def.id)});return result;
+}
+}
diff --git a/libraries/include/rtslib/systems/Loot.h b/libraries/include/rtslib/systems/Loot.h
new file mode 100644
index 00000000..8fc91191
--- /dev/null
+++ b/libraries/include/rtslib/systems/Loot.h
@@ -0,0 +1,26 @@
+#pragma once
+#include "../Progression.h"
+#include <set>
+#include <vector>
+namespace rts::lib::systems {
+struct LootRow {std::int64_t id=0,weight=0;bool rare=false;};
+struct LootConfig {std::int64_t guaranteeAfter=0;};
+struct LootState {std::int64_t misses=0;};
+// guaranteeAfter=N forces a rare item on attempt N after N-1 misses. 0 disables pity.
+// Excluded items have zero probability. An impossible guarantee fails without drawing or changing state.
+template<class Draw>
+std::optional<std::int64_t> rollLoot(std::span<const LootRow> rows,LootConfig config,LootState& state,const std::set<std::int64_t>& excluded,Draw draw){
+    if(config.guaranteeAfter<0||state.misses<0)return {};
+    const bool force=config.guaranteeAfter>0&&state.misses>=config.guaranteeAfter-1;
+    std::set<std::int64_t> ids;std::vector<rts::lib::Weighted> weights;
+    for(const auto& row:rows){
+        if(row.id<=0||row.weight<0||!ids.insert(row.id).second)return {};
+        if(!excluded.count(row.id)&&(!force||row.rare))weights.push_back({row.id,row.weight});
+    }
+    // Preflight state arithmetic before advancing caller RNG.
+    if(!force&&state.misses==std::numeric_limits<std::int64_t>::max())return {};
+    auto selected=rts::lib::weighted(std::span<const rts::lib::Weighted>(weights),draw);if(!selected)return {};
+    for(const auto& row:rows)if(row.id==*selected){state.misses=row.rare?0:state.misses+1;break;}
+    return selected;
+}
+}
diff --git a/libraries/include/rtslib/systems/Perception.h b/libraries/include/rtslib/systems/Perception.h
new file mode 100644
index 00000000..a9e02e39
--- /dev/null
+++ b/libraries/include/rtslib/systems/Perception.h
@@ -0,0 +1,32 @@
+#pragma once
+#include <cstdint>
+#include <map>
+#include <optional>
+namespace rts::lib::systems {
+struct Observation {std::int64_t entity=0,x=0,y=0,z=0,threat=0;std::uint64_t seenAt=0;};
+struct MemoryConfig {std::size_t capacity=128;std::uint64_t lifetime=200;};
+struct PerceptionMemory {std::map<std::int64_t,Observation> known;};
+// Caller provides only observations allowed by gameplay visibility, never omniscient world queries.
+inline bool observe(PerceptionMemory& memory,MemoryConfig config,Observation value){
+    if(value.entity<=0||value.threat<0||!config.capacity||memory.known.size()>config.capacity)return false;
+    auto found=memory.known.find(value.entity);
+    if(found!=memory.known.end()){if(value.seenAt<found->second.seenAt)return false;found->second=value;return true;}
+    if(memory.known.size()==config.capacity){
+        auto oldest=memory.known.begin();for(auto it=memory.known.begin();it!=memory.known.end();++it)
+            if(it->second.seenAt<oldest->second.seenAt)oldest=it;
+        if(value.seenAt<oldest->second.seenAt||(value.seenAt==oldest->second.seenAt&&value.entity<oldest->second.entity))return false;
+        memory.known.erase(oldest);
+    }
+    memory.known.emplace(value.entity,value);return true;
+}
+inline bool expire(PerceptionMemory& memory,MemoryConfig config,std::uint64_t now){
+    for(const auto& [id,o]:memory.known){(void)id;if(o.seenAt>now)return false;}
+    for(auto it=memory.known.begin();it!=memory.known.end();){if(now-it->second.seenAt>=config.lifetime)it=memory.known.erase(it);else ++it;}return true;
+}
+inline std::optional<Observation> highestThreat(const PerceptionMemory& memory,std::uint64_t now,MemoryConfig config){
+    std::optional<Observation> best;
+    for(const auto& [id,o]:memory.known){(void)id;if(o.seenAt>now||now-o.seenAt>=config.lifetime)continue;
+        if(!best||o.threat>best->threat||(o.threat==best->threat&&o.entity<best->entity))best=o;}
+    return best;
+}
+}
diff --git a/libraries/include/rtslib/systems/Persistence.h b/libraries/include/rtslib/systems/Persistence.h
new file mode 100644
index 00000000..174b2689
--- /dev/null
+++ b/libraries/include/rtslib/systems/Persistence.h
@@ -0,0 +1,53 @@
+#pragma once
+#include "modules/rts/RtsNative.h"
+#include "Reservations.h"
+#include "Sequence.h"
+#include "Loot.h"
+#include "Perception.h"
+#include <limits>
+namespace rts::lib::systems {
+inline const std::vector<std::int64_t>* record(const game::NativeState& state,const std::string& key){
+    auto it=state.arrays.find(key);return it!=state.arrays.end()&&!it->second.empty()&&it->second[0]==1?&it->second:nullptr;
+}
+inline bool storeReservations(game::NativeState& state,const std::string& key,const ReservationBook& book){
+    if(key.empty())return false;std::vector<std::int64_t> out{1};
+    for(const auto& [id,r]:book.tickets){if(id<=0||r.owner<=0||!validAmounts(r.amounts)||r.amounts.size()>INT64_MAX)return false;
+        out.insert(out.end(),{id,r.owner,static_cast<std::int64_t>(r.amounts.size())});for(auto [item,n]:r.amounts)out.insert(out.end(),{item,n});}
+    state.arrays[key]=std::move(out);return true;
+}
+inline std::optional<ReservationBook> loadReservations(const game::NativeState& state,const std::string& key){
+    auto* data=record(state,key);if(!data)return {};ReservationBook out;std::size_t i=1;
+    while(i<data->size()){
+        if(data->size()-i<3)return {};auto id=(*data)[i++],owner=(*data)[i++],count=(*data)[i++];
+        if(id<=0||owner<=0||count<=0||static_cast<std::uint64_t>(count)>(data->size()-i)/2||out.tickets.count(id))return {};
+        Reservation r;r.owner=owner;for(std::int64_t j=0;j<count;++j){auto item=(*data)[i++],n=(*data)[i++];if(item<=0||n<=0||!r.amounts.emplace(item,n).second)return {};}
+        out.tickets.emplace(id,std::move(r));
+    }
+    return out;
+}
+inline bool storeSequence(game::NativeState& state,const std::string& key,const SequenceState& sequence){
+    if(key.empty()||sequence.stage>INT64_MAX||sequence.started>INT64_MAX||sequence.lastTick>INT64_MAX||(sequence.phase<SequencePhase::Ready||sequence.phase>SequencePhase::Failed))return false;
+    state.arrays[key]={1,static_cast<std::int64_t>(sequence.stage),static_cast<std::int64_t>(sequence.started),static_cast<std::int64_t>(sequence.lastTick),sequence.hasTick?1:0,static_cast<std::int64_t>(sequence.phase)};return true;
+}
+inline std::optional<SequenceState> loadSequence(const game::NativeState& state,const std::string& key){
+    auto* d=record(state,key);if(!d||d->size()!=6)return {};
+    for(auto n:*d)if(n<0)return {};
+    if((*d)[4]>1||(*d)[5]>static_cast<std::int64_t>(SequencePhase::Failed)||static_cast<std::uint64_t>((*d)[1])>std::numeric_limits<std::size_t>::max())return {};
+    return SequenceState{static_cast<std::size_t>((*d)[1]),static_cast<std::uint64_t>((*d)[2]),static_cast<std::uint64_t>((*d)[3]),(*d)[4]!=0,static_cast<SequencePhase>((*d)[5])};
+}
+inline bool storeMemory(game::NativeState& state,const std::string& key,const PerceptionMemory& memory){
+    if(key.empty())return false;std::vector<std::int64_t> out{1};
+    for(const auto& [id,o]:memory.known){if(id<=0||id!=o.entity||o.threat<0||o.seenAt>INT64_MAX)return false;out.insert(out.end(),{id,o.x,o.y,o.z,o.threat,static_cast<std::int64_t>(o.seenAt)});}
+    state.arrays[key]=std::move(out);return true;
+}
+inline std::optional<PerceptionMemory> loadMemory(const game::NativeState& state,const std::string& key,std::size_t capacity){
+    auto* d=record(state,key);if(!d||(d->size()-1)%6||(d->size()-1)/6>capacity)return {};
+    PerceptionMemory out;for(std::size_t i=1;i<d->size();i+=6){
+        Observation o{(*d)[i],(*d)[i+1],(*d)[i+2],(*d)[i+3],(*d)[i+4],static_cast<std::uint64_t>((*d)[i+5])};
+        if(o.entity<=0||o.threat<0||(*d)[i+5]<0||!out.known.emplace(o.entity,o).second)return {};
+    }
+    return out;
+}
+inline bool storeLoot(game::NativeState& state,const std::string& key,LootState loot){if(key.empty()||loot.misses<0)return false;state.arrays[key]={1,loot.misses};return true;}
+inline std::optional<LootState> loadLoot(const game::NativeState& state,const std::string& key){auto* d=record(state,key);if(!d||d->size()!=2||(*d)[1]<0)return {};return LootState{(*d)[1]};}
+}
diff --git a/libraries/include/rtslib/systems/Reservations.h b/libraries/include/rtslib/systems/Reservations.h
new file mode 100644
index 00000000..7abb6a52
--- /dev/null
+++ b/libraries/include/rtslib/systems/Reservations.h
@@ -0,0 +1,43 @@
+#pragma once
+#include <cstdint>
+#include <map>
+namespace rts::lib::systems {
+using Quantities=std::map<std::int64_t,std::int64_t>;
+struct Reservation {std::int64_t owner=0;Quantities amounts;bool operator==(const Reservation&)const=default;};
+struct ReservationBook {std::map<std::int64_t,Reservation> tickets;};
+enum class ReserveResult {Ok,Duplicate,Conflict,Invalid,Insufficient,Missing};
+inline bool validAmounts(const Quantities& amounts){if(amounts.empty())return false;for(auto [id,n]:amounts)if(id<=0||n<=0)return false;return true;}
+// Stock is total capacity, including reservations. Only this API may consume custom stock while reserved.
+inline ReserveResult reserve(ReservationBook& book,const Quantities& stock,std::int64_t ticket,std::int64_t owner,const Quantities& requested){
+    if(ticket<=0||owner<=0||!validAmounts(requested))return ReserveResult::Invalid;
+    Reservation next{owner,requested};auto existing=book.tickets.find(ticket);
+    if(existing!=book.tickets.end())return existing->second==next?ReserveResult::Duplicate:ReserveResult::Conflict;
+    for(auto [id,amount]:requested){
+        auto it=stock.find(id);if(it==stock.end()||it->second<amount)return ReserveResult::Insufficient;
+        auto available=it->second-amount;
+        for(const auto& [key,r]:book.tickets){(void)key;auto p=r.amounts.find(id);if(p!=r.amounts.end()){if(p->second<=0||p->second>available)return ReserveResult::Insufficient;available-=p->second;}}
+    }
+    book.tickets.emplace(ticket,std::move(next));return ReserveResult::Ok;
+}
+inline ReserveResult release(ReservationBook& book,std::int64_t ticket,std::int64_t owner){
+    auto it=book.tickets.find(ticket);if(it==book.tickets.end())return ReserveResult::Missing;
+    if(it->second.owner!=owner)return ReserveResult::Conflict;
+    book.tickets.erase(it);return ReserveResult::Ok;
+}
+inline ReserveResult commit(ReservationBook& book,Quantities& stock,std::int64_t ticket,std::int64_t owner){
+    auto it=book.tickets.find(ticket);if(it==book.tickets.end())return ReserveResult::Missing;
+    if(it->second.owner!=owner)return ReserveResult::Conflict;
+    if(!validAmounts(it->second.amounts))return ReserveResult::Invalid;
+    for(auto [id,n]:it->second.amounts){
+        (void)n;auto p=stock.find(id);if(p==stock.end()||p->second<0)return ReserveResult::Insufficient;
+        auto remaining=p->second;
+        for(const auto& [key,r]:book.tickets){(void)key;auto amount=r.amounts.find(id);if(amount!=r.amounts.end()){
+            if(amount->second<=0)return ReserveResult::Invalid;
+            if(amount->second>remaining)return ReserveResult::Insufficient;
+            remaining-=amount->second;
+        }}
+    }
+    for(auto [id,n]:it->second.amounts)stock.at(id)-=n;
+    book.tickets.erase(it);return ReserveResult::Ok;
+}
+}
diff --git a/libraries/include/rtslib/systems/Sequence.h b/libraries/include/rtslib/systems/Sequence.h
new file mode 100644
index 00000000..b038e5c4
--- /dev/null
+++ b/libraries/include/rtslib/systems/Sequence.h
@@ -0,0 +1,40 @@
+#pragma once
+#include <cstdint>
+#include <cstddef>
+#include <span>
+namespace rts::lib::systems {
+struct ActionStage {std::int64_t action=0;std::uint64_t minimumTicks=0,timeoutTicks=0;};
+enum class StageResult {Pending,Complete,Failed};
+enum class SequencePhase {Ready,Running,Complete,Cancelled,Failed};
+struct SequenceState {std::size_t stage=0;std::uint64_t started=0,lastTick=0;bool hasTick=false;SequencePhase phase=SequencePhase::Ready;};
+// At most one stage transition per call. All callbacks run synchronously; persist State after the tick.
+template<class Begin,class Poll,class Cleanup>
+bool advanceSequence(std::span<const ActionStage> plan,SequenceState& state,std::uint64_t tick,Begin begin,Poll poll,Cleanup cleanup){
+    for(const auto& stage:plan)if(stage.action<=0||(stage.timeoutTicks&&stage.timeoutTicks<stage.minimumTicks))return false;
+    if(state.phase!=SequencePhase::Ready&&state.phase!=SequencePhase::Running)return false;
+    if(state.stage>plan.size()||(state.hasTick&&tick<=state.lastTick))return false;
+    if(state.phase==SequencePhase::Running&&(state.stage==plan.size()||tick<state.started))return false;
+    state.lastTick=tick;state.hasTick=true;
+    if(state.stage==plan.size()){state.phase=SequencePhase::Complete;return true;}
+    const auto& stage=plan[state.stage];
+    if(state.phase==SequencePhase::Ready){
+        if(!begin(stage.action)){state.phase=SequencePhase::Failed;return true;}
+        state.started=tick;state.phase=SequencePhase::Running;return true;
+    }
+    auto elapsed=tick-state.started;
+    auto result=poll(stage.action);
+    if(result==StageResult::Failed||(stage.timeoutTicks&&elapsed>=stage.timeoutTicks&&result!=StageResult::Complete)){
+        cleanup(stage.action,false);state.phase=SequencePhase::Failed;return true;
+    }
+    if(result==StageResult::Complete&&elapsed>=stage.minimumTicks){
+        cleanup(stage.action,true);++state.stage;state.phase=state.stage==plan.size()?SequencePhase::Complete:SequencePhase::Ready;
+    }
+    return true;
+}
+template<class Cleanup>
+bool cancelSequence(std::span<const ActionStage> plan,SequenceState& state,Cleanup cleanup){
+    if(state.phase!=SequencePhase::Ready&&state.phase!=SequencePhase::Running)return false;
+    if(state.phase==SequencePhase::Running){if(state.stage>=plan.size())return false;cleanup(plan[state.stage].action,false);}
+    state.phase=SequencePhase::Cancelled;return true;
+}
+}
diff --git a/libraries/include/rtslib/systems/Tags.h b/libraries/include/rtslib/systems/Tags.h
new file mode 100644
index 00000000..0c959b8a
--- /dev/null
+++ b/libraries/include/rtslib/systems/Tags.h
@@ -0,0 +1,18 @@
+#pragma once
+#include <cstdint>
+#include <optional>
+#include <span>
+namespace rts::lib::systems {
+struct TagQuery {std::uint64_t all=0,any=0,none=0;};
+inline bool matches(std::uint64_t tags,TagQuery q){return (tags&q.all)==q.all&&(!q.any||(tags&q.any))&&!(tags&q.none);}
+// Resolver returns optional mask; unknown names must not silently turn into unconstrained filters.
+template<class Name,class Resolve>
+std::optional<std::uint64_t> resolveTags(std::span<const Name> names,Resolve resolve){
+    std::uint64_t mask=0;for(const auto& name:names){auto found=resolve(name);if(!found||!*found)return {};mask|=*found;}return mask;
+}
+struct Condition {std::int64_t key=0,minimum=0,maximum=0;};
+template<class Read>
+bool conditions(std::span<const Condition> rows,Read read){
+    for(const auto& row:rows){if(row.minimum>row.maximum)return false;auto v=read(row.key);if(!v||*v<row.minimum||*v>row.maximum)return false;}return true;
+}
+}

diff --git a/libraries/include/rtslib/app/Lifecycle.h b/libraries/include/rtslib/app/Lifecycle.h
new file mode 100644
index 00000000..ee1f5499
--- /dev/null
+++ b/libraries/include/rtslib/app/Lifecycle.h
@@ -0,0 +1,30 @@
+#pragma once
+#include <cstdint>
+namespace rts::lib::app {
+enum class AppPhase { Boot, Menu, Loading, Playing, Paused, Results, Error, Stopped };
+enum class AppEvent { Ready, Start, Loaded, Pause, Resume, Finish, Back, Fail, Retry, Quit };
+struct Lifecycle {
+    AppPhase phase=AppPhase::Boot;
+    std::uint64_t generation=0;
+    bool send(AppEvent event) {
+        AppPhase next=phase;
+        if (phase==AppPhase::Stopped) return false;
+        if (event==AppEvent::Quit) next=AppPhase::Stopped;
+        else if (event==AppEvent::Fail) next=AppPhase::Error;
+        else switch (phase) {
+            case AppPhase::Boot: if(event==AppEvent::Ready) next=AppPhase::Menu; break;
+            case AppPhase::Menu: if(event==AppEvent::Start) next=AppPhase::Loading; break;
+            case AppPhase::Loading: if(event==AppEvent::Loaded) next=AppPhase::Playing; else if(event==AppEvent::Back) next=AppPhase::Menu; break;
+            case AppPhase::Playing: if(event==AppEvent::Pause) next=AppPhase::Paused; else if(event==AppEvent::Finish) next=AppPhase::Results; break;
+            case AppPhase::Paused: if(event==AppEvent::Resume) next=AppPhase::Playing; else if(event==AppEvent::Back) next=AppPhase::Menu; else if(event==AppEvent::Finish) next=AppPhase::Results; break;
+            case AppPhase::Results: if(event==AppEvent::Back) next=AppPhase::Menu; break;
+            case AppPhase::Error: if(event==AppEvent::Retry) next=AppPhase::Boot; else if(event==AppEvent::Back) next=AppPhase::Menu; break;
+            case AppPhase::Stopped: break;
+        }
+        if(next==phase) return false;
+        phase=next; ++generation; return true;
+    }
+    // Capture generation before asynchronous loads; reject completions from cancelled loads.
+    bool loaded(std::uint64_t ticket) { return ticket==generation && send(AppEvent::Loaded); }
+};
+}
diff --git a/libraries/include/rtslib/app/MatchBridge.h b/libraries/include/rtslib/app/MatchBridge.h
new file mode 100644
index 00000000..513d528c
--- /dev/null
+++ b/libraries/include/rtslib/app/MatchBridge.h
@@ -0,0 +1,18 @@
+#pragma once
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <utility>
+namespace rts::lib::app {
+struct RewardReceipt { std::string match, player, currency; std::int64_t amount=0; };
+inline std::string rewardKey(const RewardReceipt& r) { return "match:"+std::to_string(r.player.size())+":"+r.player+std::to_string(r.match.size())+":"+r.match; }
+// Economy is rts::meta::Economy. Reuse its receipts, balance limits and durable CAS transaction.
+// Invoke only for an authoritative final result (never a predicted finish or replay event).
+// Nullopt is invalid envelope; otherwise preserve the exact meta::Result including Duplicate/Conflict.
+template<class Economy>
+auto grantMatch(Economy& economy,const RewardReceipt& r)
+    -> std::optional<decltype(economy.transact(std::string{}, {}, {{std::string{}, std::int64_t{}}}))> {
+    if(r.match.empty()||r.player.empty()||r.currency.empty()||r.amount<0||economy.profile().player!=r.player)return std::nullopt;
+    return economy.transact(rewardKey(r),{},{{r.currency,r.amount}});
+}
+}
diff --git a/libraries/include/rtslib/app/Performance.h b/libraries/include/rtslib/app/Performance.h
new file mode 100644
index 00000000..f8fa74a1
--- /dev/null
+++ b/libraries/include/rtslib/app/Performance.h
@@ -0,0 +1,26 @@
+#pragma once
+#include <algorithm>
+#include <cstdint>
+#include <optional>
+#include <vector>
+namespace rts::lib::app {
+struct Budget { std::uint64_t maximumP95=16667,maximumPeak=100000;std::uint32_t regressionPermille=100;std::size_t minimumSamples=30; };
+struct Measurements { std::uint64_t median=0,p95=0,peak=0;std::size_t count=0; };
+inline std::optional<Measurements> summarize(std::vector<std::uint64_t> samples) {
+    if(samples.empty())return std::nullopt;
+    std::sort(samples.begin(),samples.end());
+    const auto n=samples.size(); const auto p95=n-1-(n/20); // nearest-rank ceil(.95*n)-1
+    return Measurements{samples[(n-1)/2],samples[p95],samples.back(),n};
+}
+enum class BudgetResult { Pass, InsufficientSamples, AbsoluteLimit, Regression };
+inline BudgetResult checkBudget(const Measurements& current,Budget b={},std::optional<Measurements> baseline={}) {
+    if(current.count<b.minimumSamples)return BudgetResult::InsufficientSamples;
+    if(current.p95>b.maximumP95||current.peak>b.maximumPeak)return BudgetResult::AbsoluteLimit;
+    if(baseline&&current.p95>baseline->p95){
+        // Compare in long double on host only; never feed timing measurements into sim outcomes.
+        auto allowed=static_cast<long double>(baseline->p95)*(1.0L+static_cast<long double>(b.regressionPermille)/1000.0L);
+        if(static_cast<long double>(current.p95)>allowed)return BudgetResult::Regression;
+    }
+    return BudgetResult::Pass;
+}
+}
diff --git a/libraries/include/rtslib/app/Planner.h b/libraries/include/rtslib/app/Planner.h

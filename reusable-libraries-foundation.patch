+++ b/libraries/include/rtslib/app/Planner.h
@@ -0,0 +1,24 @@
+#pragma once
+#include "Content.h"
+#include <set>
+namespace rts::lib::app {
+struct ChangeRecipe { std::string id;std::vector<std::string> dependencies,files,checks; };
+struct ChangePlan { std::vector<std::string> recipes,files,checks;std::string error;explicit operator bool()const{return error.empty();} };
+inline ChangePlan planChanges(const std::vector<ChangeRecipe>& catalog,const std::vector<std::string>& requested) {
+    std::map<std::string,const ChangeRecipe*> byId;
+    for(const auto& r:catalog)if(r.id.empty()||!byId.emplace(r.id,&r).second)return {{},{},{},"duplicate or empty recipe"};
+    std::set<std::string> selected;
+    std::vector<std::string> queue=requested;
+    for(std::size_t i=0;i<queue.size();++i){
+        auto it=byId.find(queue[i]);if(it==byId.end())return {{},{},{},"unknown recipe: "+queue[i]};
+        if(!selected.insert(queue[i]).second)continue;
+        queue.insert(queue.end(),it->second->dependencies.begin(),it->second->dependencies.end());
+    }
+    std::vector<ContentPackage> packages;
+    for(const auto& id:selected){ContentPackage p{id,"recipe",1,{}, {}};for(const auto& dep:byId.at(id)->dependencies)p.dependencies.push_back({dep,1,0});packages.push_back(std::move(p));}
+    auto order=resolveContent(packages);if(!order)return {{},{},{},order.error};
+    ChangePlan out;out.recipes=order.ids;std::set<std::string> files,checks;
+    for(const auto& id:out.recipes){const auto& r=*byId.at(id);files.insert(r.files.begin(),r.files.end());checks.insert(r.checks.begin(),r.checks.end());}
+    out.files.assign(files.begin(),files.end());out.checks.assign(checks.begin(),checks.end());return out;
+}
+}
diff --git a/libraries/include/rtslib/app/Scenario.h b/libraries/include/rtslib/app/Scenario.h
new file mode 100644
index 00000000..a78f123a
--- /dev/null
+++ b/libraries/include/rtslib/app/Scenario.h
@@ -0,0 +1,39 @@
+#pragma once
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <vector>
+namespace rts::lib::app {
+struct ScenarioStep { std::uint64_t tick=0; std::string action,payload; };
+struct ScenarioCheck { std::uint64_t tick=0; std::string metric;std::int64_t minimum=0,maximum=0; };
+struct Scenario { std::vector<ScenarioStep> steps; std::vector<ScenarioCheck> checks; };
+inline bool validScenario(const Scenario& s) {
+    std::uint64_t previous=0;
+    for(const auto& x:s.steps){if(x.action.empty()||x.tick<previous)return false;previous=x.tick;}
+    previous=0;
+    for(const auto& x:s.checks){if(x.metric.empty()||x.minimum>x.maximum||x.tick<previous)return false;previous=x.tick;}
+    return true;
+}
+struct ScenarioRunner {
+    std::size_t step=0,check=0;
+    std::uint64_t lastTick=0;
+    bool started=false,failed=false;
+    std::string error;
+    // Call at each exact sim tick. Host emits normal Commands; metric callback returns optional<int64_t>.
+    template<class Emit,class Read>
+    bool advance(const Scenario& s,std::uint64_t tick,Emit emit,Read read) {
+        if(failed)return false;
+        if(!validScenario(s)||(started&&tick<=lastTick)){failed=true;error="invalid scenario or tick order";return false;}
+        lastTick=tick;started=true;
+        while(step<s.steps.size()&&s.steps[step].tick<=tick){
+            if(s.steps[step].tick!=tick||!emit(s.steps[step])){failed=true;error="missed or rejected action";return false;}++step;
+        }
+        while(check<s.checks.size()&&s.checks[check].tick<=tick){
+            const auto& c=s.checks[check];auto value=read(c.metric);
+            if(c.tick!=tick||!value||*value<c.minimum||*value>c.maximum){failed=true;error="assertion failed: "+c.metric;return false;}++check;
+        }
+        return true;
+    }
+    bool complete(const Scenario& s)const{return !failed&&step==s.steps.size()&&check==s.checks.size();}
+};
+}
diff --git a/libraries/include/rtslib/app/Screens.h b/libraries/include/rtslib/app/Screens.h
new file mode 100644
index 00000000..a79da03e
--- /dev/null
+++ b/libraries/include/rtslib/app/Screens.h
@@ -0,0 +1,59 @@
+#pragma once
+#include "Binding.h"
+#include <algorithm>
+#include <optional>
+#include <set>
+
+namespace rts::lib::app {
+enum class ScreenKind { Hud, Build, Unit, Inventory, Technology, Pause, Results };
+struct ScreenRow { std::string id, labelKey, value, action, reasonKey; bool enabled = true; };
+struct Screen { std::string id, titleKey; ScreenKind kind = ScreenKind::Hud; bool modal = false; std::vector<ScreenRow> rows; };
+inline bool validScreen(const Screen& screen) {
+    if (screen.id.empty() || screen.titleKey.empty()) return false;
+    std::set<std::string> ids;
+    for (const auto& row : screen.rows) if (row.id.empty() || !ids.insert(row.id).second) return false;
+    return true;
+}
+// Rebuild only when the host's snapshot changes; translator returns localized text.
+template<class Translate>
+std::string screenMarkup(const Screen& screen, Translate translate) {
+    if (!validScreen(screen)) return {};
+    std::string out = "<div class=\"screen\"><h1>" + escapeMarkup(translate(screen.titleKey)) + "</h1>";
+    for (const auto& row : screen.rows) {
+        out += "<div class=\"row\"><span>" + escapeMarkup(translate(row.labelKey)) + "</span><span>" + escapeMarkup(row.value) + "</span>";
+        if (!row.action.empty()) out += "<button id=\"" + escapeMarkup(row.id) + "\"" + (row.enabled ? "" : " disabled=\"disabled\"") + ">" + escapeMarkup(translate(row.labelKey)) + "</button>";
+        if (!row.reasonKey.empty()) out += "<span class=\"reason\">" + escapeMarkup(translate(row.reasonKey)) + "</span>";
+        out += "</div>";
+    }
+    return out + "</div>";
+}
+class ScreenStack {
+    std::vector<Screen> screens_;
+public:
+    bool open(Screen screen) {
+        if (!validScreen(screen)) return false;
+        auto it = std::find_if(screens_.begin(), screens_.end(), [&](const auto& s) { return s.id == screen.id; });
+        if (it != screens_.end()) *it = std::move(screen);
+        else screens_.push_back(std::move(screen));
+        return true;
+    }
+    bool close(const std::string& id) {
+        auto it = std::find_if(screens_.begin(), screens_.end(), [&](const auto& s) { return s.id == id; });
+        if (it == screens_.end()) return false;
+        screens_.erase(it); return true;
+    }
+    bool blocksGameInput() const {
+        return std::any_of(screens_.begin(), screens_.end(), [](const auto& s) { return s.modal; });
+    }
+    std::optional<Action> click(const std::string& screenId, const std::string& rowId) const {
+        for (auto it = screens_.rbegin(); it != screens_.rend(); ++it) {
+            if (it->id == screenId) {
+                for (const auto& r : it->rows) if (r.id == rowId && r.enabled && !r.action.empty()) return Action{r.action, r.id};
+                return std::nullopt;
+            }
+            if (it->modal) return std::nullopt;
+        }
+        return std::nullopt;
+    }
+};
+}
diff --git a/libraries/include/rtslib/app/Session.h b/libraries/include/rtslib/app/Session.h
new file mode 100644
index 00000000..23dc72f8
--- /dev/null
+++ b/libraries/include/rtslib/app/Session.h
@@ -0,0 +1,44 @@
+#pragma once
+#include <cstdint>
+#include <limits>
+#include <string>
+namespace rts::lib::app {
+enum class SessionPhase { Idle, Connecting, Lobby, Playing, Reconnecting, Closed };
+struct SessionConfig { std::uint32_t maxRetries=3; std::uint64_t retryDelay=1000; };
+struct Session {
+    SessionPhase phase=SessionPhase::Idle, resumePhase=SessionPhase::Lobby;
+    SessionConfig config;
+    std::uint32_t retries=0;
+    std::uint64_t nextRetry=0, epoch=0, lastSequence=0;
+    bool hasSequence=false;
+    std::string contentHash;
+    bool connect(std::string hash) {
+        if(hash.empty()||(phase!=SessionPhase::Idle&&phase!=SessionPhase::Closed)) return false;
+        contentHash=std::move(hash);phase=SessionPhase::Connecting;retries=0;++epoch;hasSequence=false;return true;
+    }
+    bool connected(std::uint64_t ticket, const std::string& hash) {
+        if(ticket!=epoch||(phase!=SessionPhase::Connecting&&phase!=SessionPhase::Reconnecting)) return false;
+        if(hash!=contentHash){phase=SessionPhase::Closed;return false;}
+        phase=phase==SessionPhase::Reconnecting?resumePhase:SessionPhase::Lobby;retries=0;return true;
+    }
+    bool start() { if(phase!=SessionPhase::Lobby)return false;phase=SessionPhase::Playing;return true; }
+    void disconnected(std::uint64_t now) {
+        if(phase==SessionPhase::Idle||phase==SessionPhase::Closed)return;
+        if(phase!=SessionPhase::Reconnecting) resumePhase=phase==SessionPhase::Playing?SessionPhase::Playing:SessionPhase::Lobby;
+        phase=SessionPhase::Reconnecting;++epoch;
+        nextRetry=config.retryDelay>std::numeric_limits<std::uint64_t>::max()-now?std::numeric_limits<std::uint64_t>::max():now+config.retryDelay;
+    }
+    bool retry(std::uint64_t now) {
+        if(phase!=SessionPhase::Reconnecting||now<nextRetry)return false;
+        if(retries>=config.maxRetries){phase=SessionPhase::Closed;return false;}
+        ++retries;++epoch;
+        nextRetry=config.retryDelay>std::numeric_limits<std::uint64_t>::max()-now?std::numeric_limits<std::uint64_t>::max():now+config.retryDelay;
+        return true;
+    }
+    bool accept(std::uint64_t ticket,std::uint64_t sequence) {
+        if(ticket!=epoch||phase!=SessionPhase::Playing||(hasSequence&&sequence<=lastSequence))return false;
+        lastSequence=sequence;hasSequence=true;return true;
+    }
+    void close(){phase=SessionPhase::Closed;++epoch;}
+};
+}
diff --git a/libraries/include/rtslib/app/Theme.h b/libraries/include/rtslib/app/Theme.h
new file mode 100644
index 00000000..2636d64d
--- /dev/null
+++ b/libraries/include/rtslib/app/Theme.h
@@ -0,0 +1,31 @@
+#pragma once
+#include <algorithm>
+#include <cmath>
+#include <optional>
+#include <string>
+
+namespace rts::lib::app {
+struct Insets { int left=0, top=0, right=0, bottom=0; };
+struct Layout { int x=0, y=0, width=0, height=0, columns=1; };
+struct LayoutConfig { int minimumColumn=280, gap=12, maximumColumns=4; float minimumScale=0.75f, maximumScale=2.0f; };
+inline std::optional<Layout> layout(int width, int height, Insets safe, LayoutConfig c = {}) {
+    if (width <= 0 || height <= 0 || safe.left < 0 || safe.right < 0 || safe.top < 0 || safe.bottom < 0 || c.minimumColumn <= 0 || c.gap < 0 || c.maximumColumns <= 0) return std::nullopt;
+    const auto w = static_cast<long long>(width) - safe.left - safe.right;
+    const auto h = static_cast<long long>(height) - safe.top - safe.bottom;
+    if (w <= 0 || h <= 0) return std::nullopt;
+    auto columns = std::clamp((w + c.gap) / (static_cast<long long>(c.minimumColumn) + c.gap), 1LL, static_cast<long long>(c.maximumColumns));
+    return Layout{safe.left, safe.top, static_cast<int>(w), static_cast<int>(h), static_cast<int>(columns)};
+}
+inline std::optional<float> uiScale(float requested, LayoutConfig c = {}) {
+    if (!std::isfinite(requested) || !std::isfinite(c.minimumScale) || !std::isfinite(c.maximumScale) || c.minimumScale <= 0 || c.maximumScale < c.minimumScale) return std::nullopt;
+    return std::clamp(requested, c.minimumScale, c.maximumScale);
+}
+struct Theme { std::string background="#151c28", foreground="#eeeeee", accent="#64b5ff"; int spacing=12, fontSize=16; };
+inline bool colorToken(const std::string& s) {
+    return s.size()==7 && s[0]=='#' && std::all_of(s.begin()+1,s.end(),[](char c){return (c>='0'&&c<='9')||(c>='a'&&c<='f')||(c>='A'&&c<='F');});
+}
+inline std::optional<std::string> themeStyles(const Theme& t) {
+    if (!colorToken(t.background)||!colorToken(t.foreground)||!colorToken(t.accent)||t.spacing<0||t.spacing>128||t.fontSize<8||t.fontSize>96) return std::nullopt;
+    return "body { background-color: "+t.background+"; color: "+t.foreground+"; font-size: "+std::to_string(t.fontSize)+"dp; } .screen { padding: "+std::to_string(t.spacing)+"dp; } .row { display: block; margin-bottom: "+std::to_string(t.spacing)+"dp; } button { background-color: "+t.accent+"; }";
+}
+}
diff --git a/libraries/include/rtslib/bots/Config.h b/libraries/include/rtslib/bots/Config.h
new file mode 100644
index 00000000..a7bce67a
--- /dev/null
+++ b/libraries/include/rtslib/bots/Config.h
@@ -0,0 +1,28 @@
+#pragma once
+#include "engine/data/Json.h"
+#include <initializer_list>
+#include <string_view>
+namespace rts::lib::bots {
+// Project-local bot configuration, not additional engine rules keys.
+inline void keys(const Json& j,std::initializer_list<std::string_view> allowed) {
+    if(!j.isObject())throw JsonError("bots: expected object");
+    for(const auto& [key,value]:j.members()) {
+        (void)value;bool found=false;for(auto name:allowed)if(key==name)found=true;
+        if(!found)throw JsonError("bots: unknown setting '"+key+"'");
+    }
+}
+inline int64_t integer(const Json& j,const char* key,int64_t fallback,int64_t lo,int64_t hi) {
+    if(!j.has(key)){if(fallback<lo||fallback>hi)throw JsonError(std::string("bots.")+key+": incompatible default; set explicitly");return fallback;}
+    if(!j[key].isNumber()||j[key].fx().raw%Fixed::kOne)throw JsonError(std::string("bots.")+key+": expected integer");
+    auto v=j[key].fx().floorInt();if(v<lo||v>hi)throw JsonError(std::string("bots.")+key+": outside range");return v;
+}
+inline Fixed number(const Json& j,const char* key,Fixed fallback,Fixed lo,Fixed hi) {
+    if(!j.has(key)){if(fallback<lo||fallback>hi)throw JsonError(std::string("bots.")+key+": incompatible default; set explicitly");return fallback;}
+    if(!j[key].isNumber())throw JsonError(std::string("bots.")+key+": expected number");
+    auto v=j[key].fx();if(v<lo||v>hi)throw JsonError(std::string("bots.")+key+": outside range");return v;
+}
+inline std::string preset(const Json& j) {
+    if(j.has("preset")&&!j["preset"].isString())throw JsonError("bots.preset: expected string");
+    return j.getStr("preset","normal");
+}
+}
diff --git a/libraries/include/rtslib/bots/Fps.h b/libraries/include/rtslib/bots/Fps.h
new file mode 100644
index 00000000..aa738898
--- /dev/null
+++ b/libraries/include/rtslib/bots/Fps.h
@@ -0,0 +1,167 @@
+#pragma once
+#include "Config.h"
+#include "Navigation.h"
+#include "NavMesh.h"
+#include "modules/fps/FpsModule.h"
+#include "engine/core/FixedMath.h"
+#include <limits>
+namespace rts::lib::bots {
+enum class FpsDecision : uint8_t {Idle,Patrol,Investigate,Engage,Reload,Retreat,Zone,Blocked};
+struct FpsConfig {
+    uint32_t reactionTicks=12,memoryTicks=180,sensorTicks=6,navigationBudget=2048;
+    Fixed sightRange=80_fx,halfFov=Fixed::fromRatio(1,5),turnPerTick=Fixed::fromRatio(1,60);
+    Fixed aimTolerance=Fixed::fromRatio(1,200),aimError=Fixed::fromRatio(1,2000);
+    Fixed preferredRange=15_fx,arrivalRadius=1_fx;
+    int32_t retreatHealth=25,strafe=250;
+};
+inline bool valid(const FpsConfig& c){
+    return c.navigationBudget>=16&&c.navigationBudget<=8192&&c.reactionTicks<=3600&&c.memoryTicks<=36000&&c.sensorTicks>=1&&c.sensorTicks<=3600&&
+        c.sightRange>=1_fx&&c.sightRange<=10000_fx&&c.halfFov>=Fixed::fromRatio(1,360)&&c.halfFov<=Fixed::fromRatio(1,2)&&
+        c.turnPerTick>Fixed{}&&c.turnPerTick<=Fixed::fromRatio(1,2)&&c.aimTolerance>=Fixed{}&&c.aimTolerance<=Fixed::fromRatio(1,8)&&
+        c.aimError>=Fixed{}&&c.aimError<=Fixed::fromRatio(1,8)&&c.preferredRange>=1_fx&&c.preferredRange<=10000_fx&&
+        c.arrivalRadius>=Fixed::fromRatio(1,10)&&c.arrivalRadius<=10_fx&&c.retreatHealth>=0&&c.retreatHealth<=100&&c.strafe>=0&&c.strafe<=1000;
+}
+inline FpsConfig fpsConfig(const Json& j) {
+    keys(j,{"preset","navigationBudget","reactionTicks","memoryTicks","sensorTicks","sightRange","halfFov","turnPerTick","aimTolerance","aimError","preferredRange","arrivalRadius","retreatHealth","strafe"});
+    FpsConfig c;auto p=preset(j);
+    if(p=="easy"){c.reactionTicks=30;c.turnPerTick=Fixed::fromRatio(1,120);c.aimError=Fixed::fromRatio(1,500);c.strafe=0;}
+    else if(p=="hard"){c.reactionTicks=6;c.sensorTicks=3;c.turnPerTick=Fixed::fromRatio(1,40);c.aimError={};c.strafe=400;}
+    else if(p=="guard"){c.preferredRange=30_fx;c.strafe=0;c.retreatHealth=40;}
+    else if(p=="rusher"){c.preferredRange=5_fx;c.strafe=150;c.retreatHealth=10;}
+    else if(p=="survivor"){c.preferredRange=25_fx;c.retreatHealth=60;}
+    else if(p!="normal")throw JsonError("bots.preset: unknown FPS preset '"+p+"'");
+    c.navigationBudget=uint32_t(integer(j,"navigationBudget",c.navigationBudget,16,8192));
+    c.reactionTicks=uint32_t(integer(j,"reactionTicks",c.reactionTicks,0,3600));
+    c.memoryTicks=uint32_t(integer(j,"memoryTicks",c.memoryTicks,0,36000));c.sensorTicks=uint32_t(integer(j,"sensorTicks",c.sensorTicks,1,3600));
+    c.sightRange=number(j,"sightRange",c.sightRange,1_fx,10000_fx);c.halfFov=number(j,"halfFov",c.halfFov,Fixed::fromRatio(1,360),Fixed::fromRatio(1,2));
+    c.turnPerTick=number(j,"turnPerTick",c.turnPerTick,Fixed::fromRaw(1),Fixed::fromRatio(1,2));
+    c.aimTolerance=number(j,"aimTolerance",c.aimTolerance,Fixed{},Fixed::fromRatio(1,8));
+    c.aimError=number(j,"aimError",c.aimError,Fixed{},Fixed::fromRatio(1,8));
+    c.preferredRange=number(j,"preferredRange",c.preferredRange,1_fx,10000_fx);c.arrivalRadius=number(j,"arrivalRadius",c.arrivalRadius,Fixed::fromRatio(1,10),10_fx);
+    c.retreatHealth=int32_t(integer(j,"retreatHealth",c.retreatHealth,0,100));c.strafe=int32_t(integer(j,"strafe",c.strafe,0,1000));return c;
+}
+struct FpsState {
+    uint8_t slot=0,target=0;uint32_t life=0,targetLife=0,lastTick=0,lastSensor=0,acquired=0,lastSeen=0,sequence=0;
+    bool initialized=false;Vec3 lastKnown{};uint32_t patrol=0;FpsDecision decision=FpsDecision::Idle;
+};
+inline bool valid(const FpsState& s){
+    return uint8_t(s.decision)<=uint8_t(FpsDecision::Blocked)&&s.patrol<512&&
+        s.lastKnown.x>= -100000_fx&&s.lastKnown.x<=100000_fx&&s.lastKnown.y>= -100000_fx&&s.lastKnown.y<=100000_fx&&s.lastKnown.z>= -100000_fx&&s.lastKnown.z<=100000_fx&&
+        (!s.initialized||(s.slot>0&&s.life>0&&s.lastSensor<=s.lastTick&&s.acquired<=s.lastTick&&s.lastSeen<=s.lastTick))&&
+        ((s.target==0)==(s.targetLife==0));
+}
+inline Vec3 flat(Vec3 v){v.y={};return v;}
+inline Fixed wrapTurn(Fixed angle){angle.raw%=Fixed::kOne;if(angle<Fixed{})angle+=1_fx;return angle;}
+inline Fixed turnDelta(Fixed to,Fixed from){auto d=wrapTurn(to-from);return d>Fixed::fromRatio(1,2)?d-1_fx:d;}
+inline Vec3 eye(const fps::Actor& a,const fps::MotorConfig& c){return a.pos+Vec3{{},(a.crouched?c.crouchHeight:c.height)-Fixed::fromRatio(1,10),{}};}
+inline Vec3 center(const fps::Actor& a,const fps::MotorConfig& c){return a.pos+Vec3{{},(a.crouched?c.crouchHeight:c.height)/2,{}};}
+inline bool visible(const fps::Actor& self,const fps::Actor& other,const fps::Module& module,const FpsConfig& c){
+    if(other.slot==self.slot||other.team==self.team||other.health<=0)return false;
+    auto delta=center(other,module.config().motor)-eye(self,module.config().motor);auto distance=delta.length();
+    if(distance>c.sightRange)return false;
+    if(distance>Fixed{}&&fps::direction(self.yaw,self.pitch).dot(delta)/distance<fxCosTurns(c.halfFov))return false;
+    return !module.collision().cast(eye(self,module.config().motor),delta).hit;
+}
+inline bool friendlyInLine(const fps::Actor& self,const fps::State& world,const fps::Module& module,Fixed yaw,Fixed pitch,Fixed distance){
+    auto start=eye(self,module.config().motor),delta=fps::direction(yaw,pitch)*distance;
+    for(const auto& a:world.actors)if(a.slot!=self.slot&&a.team==self.team&&a.health>0){

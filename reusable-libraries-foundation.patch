+++ b/libraries/include/rtslib/gameplay/Input.h
@@ -0,0 +1,53 @@
+#pragma once
+#include <algorithm>
+#include <cstdint>
+#include <optional>
+#include <span>
+#include <vector>
+namespace rts::lib::gameplay {
+enum class InputPhase { Press,Release,Repeat,Axis };
+struct InputEvent { std::int64_t code=0,modifiers=0,context=0,value=0; InputPhase phase=InputPhase::Press; };
+struct Binding { std::int64_t id=0,action=0,code=0,modifiers=0,context=0,priority=0; InputPhase phase=InputPhase::Press; bool enabled=true; };
+inline std::optional<std::int64_t> resolveInput(std::span<const Binding> bindings,const InputEvent& e) {
+    const Binding* best=nullptr;
+    for (const auto& b:bindings) if (b.enabled && b.code==e.code && b.modifiers==e.modifiers && b.context==e.context && b.phase==e.phase)
+        if (!best || b.priority>best->priority || (b.priority==best->priority && b.id<best->id)) best=&b;
+    return best ? std::optional(best->action) : std::nullopt;
+}
+inline std::int64_t deadzone(std::int64_t value,std::int64_t threshold) {
+    value=std::clamp<std::int64_t>(value,-1000,1000); threshold=std::clamp<std::int64_t>(threshold,0,999);
+    const auto magnitude=value<0?-value:value;
+    return magnitude<=threshold ? 0 : (value<0?-1:1)*(magnitude-threshold)*1000/(1000-threshold);
+}
+enum class SelectionMode { Replace,Add,Toggle };
+inline void updateSelection(std::vector<std::int64_t>& selected,std::span<const std::int64_t> incoming,SelectionMode mode) {
+    if (mode==SelectionMode::Replace) selected.clear();
+    std::sort(selected.begin(),selected.end()); selected.erase(std::unique(selected.begin(),selected.end()),selected.end());
+    std::vector<std::int64_t> ids(incoming.begin(),incoming.end());
+    std::sort(ids.begin(),ids.end()); ids.erase(std::unique(ids.begin(),ids.end()),ids.end());
+    for(auto id:ids) {
+        auto at=std::lower_bound(selected.begin(),selected.end(),id);
+        if(at!=selected.end() && *at==id) { if(mode==SelectionMode::Toggle) selected.erase(at); }
+        else selected.insert(at,id);
+    }
+}
+class ControlGroups {
+public:
+    explicit ControlGroups(std::size_t count=10):groups_(std::min<std::size_t>(count,100)){}
+    bool assign(std::size_t group,std::span<const std::int64_t> ids){if(group>=groups_.size())return false;updateSelection(groups_[group],ids,SelectionMode::Replace);return true;}
+    template<class Alive> std::vector<std::int64_t> recall(std::size_t group,Alive alive)const {
+        std::vector<std::int64_t> result;if(group<groups_.size())for(auto id:groups_[group])if(alive(id))result.push_back(id);return result;
+    }
+private:std::vector<std::vector<std::int64_t>> groups_;
+};
+struct DragGesture {
+    std::int32_t startX=0,startY=0;bool active=false;
+    void begin(std::int32_t x,std::int32_t y){startX=x;startY=y;active=true;}
+    void cancel(){active=false;}
+    bool isDrag(std::int32_t x,std::int32_t y,std::int64_t threshold)const {
+        if(!active||threshold<0)return false;
+        auto dx=std::int64_t(x)-startX,dy=std::int64_t(y)-startY;
+        return dx>threshold||dx< -threshold||dy>threshold||dy< -threshold;
+    }
+};
+}
diff --git a/libraries/include/rtslib/gameplay/Inventory.h b/libraries/include/rtslib/gameplay/Inventory.h
new file mode 100644
index 00000000..a3516675
--- /dev/null
+++ b/libraries/include/rtslib/gameplay/Inventory.h
@@ -0,0 +1,63 @@
+#pragma once
+#include "Diagnostics.h"
+#include <algorithm>
+#include <cstdint>
+#include <limits>
+#include <span>
+#include <vector>
+namespace rts::lib::gameplay {
+struct ItemType { std::int64_t id=0,maxStack=1,weight=0;std::uint64_t slots=0; };
+struct ItemStack { std::int64_t type=0,count=0; };
+struct InventoryConfig { std::size_t slots=20;std::int64_t maxWeight=1000000; };
+template<class Lookup>
+Decision checkInventory(const std::vector<ItemStack>& items,const InventoryConfig& c,Lookup lookup) {
+    if(c.maxWeight<0||c.slots>65536||items.size()>c.slots)return {Reason::Capacity};std::int64_t weight=0;
+    for(const auto& stack:items) {
+        auto type=lookup(stack.type);
+        if(!type||type->maxStack<1||type->weight<0||stack.count<1||stack.count>type->maxStack)return {Reason::Invalid,stack.type};
+        if(type->weight && stack.count>(c.maxWeight-weight)/type->weight)return {Reason::Capacity,stack.type,c.maxWeight,weight};
+        weight+=stack.count*type->weight;
+    }
+    return {};
+}
+template<class Lookup>
+Decision addItem(std::vector<ItemStack>& items,const InventoryConfig& c,ItemStack item,Lookup lookup) {
+    auto before=checkInventory(items,c,lookup);if(!before)return before;
+    auto type=lookup(item.type);if(!type||item.count<1||type->maxStack<1||type->weight<0)return {Reason::Invalid,item.type};
+    auto next=items;auto remaining=item.count;
+    for(auto& s:next)if(s.type==item.type){auto n=std::min(remaining,type->maxStack-s.count);s.count+=n;remaining-=n;}
+    while(remaining>0) {if(next.size()>=c.slots)return {Reason::Capacity,item.type};auto n=std::min(remaining,type->maxStack);next.push_back({item.type,n});remaining-=n;}
+    auto result=checkInventory(next,c,lookup);if(result)items=std::move(next);return result;
+}
+inline Decision removeItem(std::vector<ItemStack>& items,ItemStack item) {
+    if(item.count<1)return {Reason::Invalid};auto remaining=item.count;
+    for(const auto& s:items)if(s.type==item.type){if(s.count<1)return {Reason::Invalid};remaining-=std::min(remaining,s.count);}
+    if(remaining)return {Reason::Missing,item.type,item.count,item.count-remaining};
+    remaining=item.count;for(auto& s:items)if(s.type==item.type){auto n=std::min(remaining,s.count);s.count-=n;remaining-=n;}
+    std::erase_if(items,[](auto s){return s.count==0;});return {};
+}
+template<class Lookup>
+Decision transferItem(std::vector<ItemStack>& from,std::vector<ItemStack>& to,const InventoryConfig& targetConfig,ItemStack item,Lookup lookup) {
+    if(&from==&to)return {Reason::Invalid};auto a=from,b=to;auto d=removeItem(a,item);if(!d)return d;d=addItem(b,targetConfig,item,lookup);if(!d)return d;from=std::move(a);to=std::move(b);return {};
+}
+inline bool canEquip(const ItemType& type,std::uint32_t slot) {return slot<64 && (type.slots&(std::uint64_t{1}<<slot));}
+struct Equipment {std::uint32_t slot=0;std::int64_t type=0;};
+template<class Lookup>
+Decision equipItem(std::vector<ItemStack>& bag,std::vector<Equipment>& equipped,std::int64_t item,std::uint32_t slot,Lookup lookup){
+    auto type=lookup(item);if(!type||!canEquip(*type,slot))return {Reason::Target,item};
+    for(const auto& e:equipped)if(e.slot==slot)return {Reason::Busy,slot};
+    auto next=bag;auto d=removeItem(next,{item,1});if(!d)return d;
+    equipped.push_back({slot,item});bag=std::move(next);return {};
+}
+template<class Lookup>
+Decision unequipItem(std::vector<ItemStack>& bag,std::vector<Equipment>& equipped,const InventoryConfig& config,std::uint32_t slot,Lookup lookup){
+    auto it=std::find_if(equipped.begin(),equipped.end(),[&](auto e){return e.slot==slot;});
+    if(it==equipped.end())return {Reason::Missing,slot};
+    auto d=addItem(bag,config,{it->type,1},lookup);if(!d)return d;equipped.erase(it);return {};
+}
+template<class Lookup>
+Decision craftItems(std::vector<ItemStack>& bag,const InventoryConfig& config,std::span<const ItemStack> input,std::span<const ItemStack> output,Lookup lookup){
+    auto next=bag;for(auto item:input){auto d=removeItem(next,item);if(!d)return d;}
+    for(auto item:output){auto d=addItem(next,config,item,lookup);if(!d)return d;}bag=std::move(next);return {};
+}
+}

+        input.right=int32_t((wish.dot(fps::direction(input.yaw-Fixed::fromRatio(1,4),{}))*1000).floorInt());
+    }else if(target&&s.decision==FpsDecision::Engage){
+        auto strafe=((tick/60+slot)%2)?c.strafe:-c.strafe;

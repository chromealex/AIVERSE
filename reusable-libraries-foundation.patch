diff --git a/libraries/include/rtslib/genre/Data.h b/libraries/include/rtslib/genre/Data.h
new file mode 100644
index 00000000..7b440d38
--- /dev/null
+++ b/libraries/include/rtslib/genre/Data.h
@@ -0,0 +1,30 @@
+#pragma once
+#include "Narrative.h"
+#include "engine/data/Json.h"
+#include <charconv>
+namespace rts::lib::genre {
+inline int64_t storyInteger(const Json& j,const char* label){
+    if(!j.isNumber())throw JsonError(std::string("story.")+label+": expected integer");auto text=j.numberLiteral();int64_t value=0;
+    auto parsed=std::from_chars(text.data(),text.data()+text.size(),value);if(parsed.ec!=std::errc{}||parsed.ptr!=text.data()+text.size())throw JsonError(std::string("story.")+label+": invalid integer");return value;
+}
+inline void storyKeys(const Json& j,std::initializer_list<std::string_view> names){
+    if(!j.isObject())throw JsonError("story: expected object");for(const auto& [key,value]:j.members()){(void)value;bool found=false;for(auto name:names)if(name==key)found=true;if(!found)throw JsonError("story: unknown key '"+key+"'");}
+}
+inline std::string storyText(const Json& j){if(!j.isString()||j.str().empty())throw JsonError("story: expected nonempty localization key");return j.str();}
+inline Story readStory(const Json& j){
+    storyKeys(j,{"nodes"});if(!j["nodes"].isArray()||j["nodes"].size()>10000)throw JsonError("story.nodes: expected at most 10000 nodes");Story graph;
+    for(const auto& item:j["nodes"].items()){
+        storyKeys(item,{"id","textKey","choices"});StoryNode node;node.id=storyInteger(item["id"],"id");node.textKey=storyText(item["textKey"]);
+        if(!item["choices"].isArray()||item["choices"].size()>128)throw JsonError("story.choices: expected at most 128 choices");
+        for(const auto& raw:item["choices"].items()){
+            storyKeys(raw,{"id","next","textKey","conditions","changes"});StoryChoice choice;choice.id=storyInteger(raw["id"],"choice.id");choice.next=storyInteger(raw["next"],"next");choice.textKey=storyText(raw["textKey"]);
+            for(auto field:{"conditions","changes"})if(raw.has(field)&&(!raw[field].isArray()||raw[field].size()>256))throw JsonError(std::string("story.")+field+": expected at most 256 records");
+            for(const auto& cond:raw["conditions"].items()){storyKeys(cond,{"key","minimum","maximum"});choice.conditions.push_back({storyInteger(cond["key"],"key"),storyInteger(cond["minimum"],"minimum"),storyInteger(cond["maximum"],"maximum")});}
+            for(const auto& effect:raw["changes"].items()){
+                storyKeys(effect,{"key","value","add"});if(effect.has("add")&&effect["add"].type()!=Json::Type::Bool)throw JsonError("story.add: expected bool");
+                choice.changes.push_back({storyInteger(effect["key"],"key"),storyInteger(effect["value"],"value"),effect.getBool("add",false)});
+            }node.choices.push_back(std::move(choice));
+        }if(!graph.emplace(node.id,std::move(node)).second)throw JsonError("story: duplicate node id");
+    }if(!valid(graph))throw JsonError("story: invalid graph, choice or condition");return graph;
+}
+}
diff --git a/libraries/include/rtslib/genre/Locomotion.h b/libraries/include/rtslib/genre/Locomotion.h
new file mode 100644
index 00000000..718e4a18
--- /dev/null
+++ b/libraries/include/rtslib/genre/Locomotion.h
@@ -0,0 +1,38 @@
+#pragma once
+#include "engine/core/FixedMath.h"
+#include <optional>
+namespace rts::lib::genre {
+struct MotionConfig {
+    Fixed groundSpeed=6_fx,airSpeed=6_fx,acceleration=30_fx,braking=40_fx,gravity=20_fx,jumpSpeed=7_fx;
+    uint32_t coyoteTicks=6,bufferTicks=6,maxJumps=1;
+};
+struct MotionState {
+    Vec3 velocity{};uint32_t lastTick=0,lastGround=0,jumpTick=0,jumps=0;
+    bool initialized=false,hasGround=false,buffered=false;
+};
+struct MotionInput {Vec2 wish{};bool grounded=false,jumpPressed=false,ceiling=false;};
+struct MotionResult {Vec3 velocity{};bool jumped=false;};
+inline bool valid(const MotionConfig& c){return c.groundSpeed>=Fixed{}&&c.groundSpeed<=100_fx&&c.airSpeed>=Fixed{}&&c.airSpeed<=100_fx&&c.acceleration>Fixed{}&&c.acceleration<=1000_fx&&c.braking>Fixed{}&&c.braking<=1000_fx&&c.gravity>=Fixed{}&&c.gravity<=1000_fx&&c.jumpSpeed>=Fixed{}&&c.jumpSpeed<=100_fx&&c.maxJumps>=1&&c.maxJumps<=16&&c.coyoteTicks<=3600&&c.bufferTicks<=3600;}
+inline std::optional<MotionResult> stepMotion(const MotionConfig& c,MotionState& state,MotionInput in,uint32_t tick,Fixed dt){
+    for(auto value:{state.velocity.x,state.velocity.y,state.velocity.z})if(value< -1000_fx||value>1000_fx)return {};
+    if(state.jumps>16||(state.hasGround&&state.lastGround>tick)||(state.buffered&&state.jumpTick>tick))return {};
+    if(!valid(c)||dt<=Fixed{}||dt>1_fx||(state.initialized&&tick<=state.lastTick)||in.wish.x< -1_fx||in.wish.x>1_fx||in.wish.y< -1_fx||in.wish.y>1_fx)return {};
+    auto s=state;s.initialized=true;s.lastTick=tick;
+    if(in.grounded){s.lastGround=tick;s.hasGround=true;s.jumps=0;if(s.velocity.y<Fixed{})s.velocity.y={};}
+    if(in.ceiling&&s.velocity.y>Fixed{})s.velocity.y={};
+    if(in.jumpPressed){s.buffered=true;s.jumpTick=tick;}
+    if(s.buffered&&tick-s.jumpTick>c.bufferTicks)s.buffered=false;
+    const bool coyote=s.hasGround&&tick-s.lastGround<=c.coyoteTicks&&s.jumps==0;
+    if(!in.grounded&&!coyote&&s.jumps==0)s.jumps=1;
+    bool jump=s.buffered&&!in.ceiling&&(in.grounded||coyote||s.jumps<c.maxJumps);
+    if(jump){s.velocity.y=c.jumpSpeed;++s.jumps;s.buffered=false;}
+    auto wish=Vec3{in.wish.x,{},in.wish.y};if(wish.lengthSq()>1_fx)wish=fxNormalize(wish);
+    auto desired=wish*(in.grounded?c.groundSpeed:c.airSpeed);auto diff=Vec3{desired.x-s.velocity.x,{},desired.z-s.velocity.z};
+    auto length=diff.length(),amount=(wish.lengthSq().raw?c.acceleration:c.braking)*dt;
+    if(length>amount)diff=fxNormalize(diff)*amount;s.velocity.x+=diff.x;s.velocity.z+=diff.z;
+    if(!in.grounded||jump)s.velocity.y=fxMax(s.velocity.y-c.gravity*dt,-1000_fx);
+    state=s;return MotionResult{s.velocity,jump};
+}
+// The existing character/physics owner performs collision and reports grounded/ceiling next tick.
+// This policy never writes positions or bypasses the FPS motor/authoritative command path.
+}
diff --git a/libraries/include/rtslib/genre/Match.h b/libraries/include/rtslib/genre/Match.h
new file mode 100644
index 00000000..8f64c3fa
--- /dev/null
+++ b/libraries/include/rtslib/genre/Match.h
@@ -0,0 +1,49 @@
+#pragma once
+#include <cstdint>
+#include <map>
+#include <optional>
+#include <limits>
+#include <span>
+namespace rts::lib::genre {
+enum class MatchPhase:uint8_t {Warmup,Live,Overtime,Intermission,Finished};
+struct MatchConfig {uint32_t warmupTicks=60,roundTicks=3600,overtimeTicks=600,intermissionTicks=120,roundsToWin=1,maxRounds=5;int64_t scoreToWin=10;};
+struct TeamScore {int64_t score=0;uint32_t wins=0;uint64_t lastEvent=0;};
+struct MatchState {std::map<int64_t,TeamScore> teams;MatchPhase phase=MatchPhase::Warmup;uint32_t phaseStart=0,lastTick=0,round=1;int64_t winner=0;bool initialized=false;};
+inline bool valid(const MatchConfig& c){return c.warmupTicks<=10000000&&c.roundTicks>0&&c.roundTicks<=10000000&&c.overtimeTicks<=10000000&&c.intermissionTicks<=10000000&&c.roundsToWin>0&&c.roundsToWin<=100&&c.maxRounds>=c.roundsToWin&&c.maxRounds<=1000&&c.scoreToWin>0;}
+inline std::optional<MatchState> makeMatch(std::span<const int64_t> teams){
+    if(teams.size()<2||teams.size()>200)return {};MatchState s;for(auto team:teams)if(team<=0||!s.teams.emplace(team,TeamScore{}).second)return {};return s;
+}
+inline bool awardScore(MatchState& s,int64_t team,uint64_t event,int64_t points){
+    auto it=s.teams.find(team);if((s.phase!=MatchPhase::Live&&s.phase!=MatchPhase::Overtime)||it==s.teams.end()||event==0||event<=it->second.lastEvent||points<0||it->second.score>std::numeric_limits<int64_t>::max()-points)return false;
+    it->second.lastEvent=event;it->second.score+=points;return true;
+}
+inline std::pair<int64_t,int64_t> leadingTeam(const MatchState& s,bool wins=false){
+    int64_t leader=-1,best=-1;for(const auto& [team,value]:s.teams){auto score=wins?int64_t(value.wins):value.score;if(score>best){best=score;leader=team;}else if(score==best)leader=-1;}return {leader,best};
+}
+inline bool stepMatch(const MatchConfig& c,MatchState& s,uint32_t tick){
+    if(s.phaseStart>tick||!valid(c)||s.teams.size()<2||uint8_t(s.phase)>uint8_t(MatchPhase::Finished)||(s.initialized&&tick<=s.lastTick))return false;
+    if(!s.initialized){s.initialized=true;s.phaseStart=tick;}s.lastTick=tick;auto age=tick-s.phaseStart;
+    if(s.phase==MatchPhase::Finished)return true;
+    if(s.phase==MatchPhase::Warmup){if(age>=c.warmupTicks){s.phase=MatchPhase::Live;s.phaseStart=tick;}return true;}
+    if(s.phase==MatchPhase::Intermission){if(age>=c.intermissionTicks){++s.round;for(auto& [team,score]:s.teams){(void)team;score.score=0;}s.phase=MatchPhase::Live;s.phaseStart=tick;}return true;}
+    auto [leader,score]=leadingTeam(s);bool finish=leader>0&&score>=c.scoreToWin;
+    if(s.phase==MatchPhase::Live&&age>=c.roundTicks){
+        if(leader<0&&c.overtimeTicks){s.phase=MatchPhase::Overtime;s.phaseStart=tick;return true;}finish=true;
+    }
+    if(s.phase==MatchPhase::Overtime&&(leader>0||age>=c.overtimeTicks))finish=true;
+    if(!finish)return true;
+    if(leader>0)++s.teams.at(leader).wins;
+    if((leader>0&&s.teams.at(leader).wins>=c.roundsToWin)||s.round>=c.maxRounds){s.phase=MatchPhase::Finished;s.winner=leadingTeam(s,true).first;}
+    else {s.phase=MatchPhase::Intermission;s.phaseStart=tick;}return true;
+}
+struct CaptureState {int64_t owner=0,candidate=0;uint32_t progress=0,lastTick=0;bool initialized=false;};
+inline std::optional<bool> stepCapture(CaptureState& s,const std::map<int64_t,uint32_t>& occupants,uint32_t requiredTicks,uint32_t tick){
+    if(s.owner<0||s.candidate<0||s.progress>10000000||!requiredTicks||requiredTicks>10000000||(s.initialized&&tick<=s.lastTick))return {};
+    int64_t candidate=0;for(auto [team,count]:occupants){if(team<=0)return {};if(!count)continue;if(candidate){candidate=-1;break;}candidate=team;}
+    s.initialized=true;s.lastTick=tick;if(candidate<0)return false;
+    if(candidate==0){if(s.progress)--s.progress;return false;}
+    if(candidate==s.owner){s.progress=0;s.candidate=0;return false;}
+    if(candidate!=s.candidate){s.candidate=candidate;s.progress=0;}
+    if(++s.progress>=requiredTicks){s.owner=candidate;s.candidate=0;s.progress=0;return true;}return false;
+}
+}
diff --git a/libraries/include/rtslib/genre/Melee.h b/libraries/include/rtslib/genre/Melee.h
new file mode 100644
index 00000000..2fd7d1ad
--- /dev/null
+++ b/libraries/include/rtslib/genre/Melee.h
@@ -0,0 +1,45 @@
+#pragma once
+#include <algorithm>
+#include <cstdint>
+#include <map>
+#include <optional>
+#include <vector>
+namespace rts::lib::genre {
+enum class AttackPhase {Idle,Windup,Active,Recovery};
+struct AttackDef {int64_t id=0;uint32_t windup=6,active=4,recovery=12,cancelFrom=10,bufferTicks=8;std::vector<int64_t> combos;};
+using AttackSet=std::map<int64_t,AttackDef>;
+struct MeleeState {int64_t attack=0,queued=0;uint32_t started=0,queuedAt=0,lastTick=0;bool initialized=false;std::vector<int64_t> hitTargets;};
+inline bool valid(const AttackSet& defs){
+    if(defs.empty()||defs.size()>1024)return false;
+    for(const auto& [id,d]:defs){if(id<=0||d.id!=id||d.active==0||d.windup>3600||d.active>3600||d.recovery>3600||d.cancelFrom>d.windup+d.active+d.recovery||d.bufferTicks>3600)return false;for(auto next:d.combos)if(!defs.contains(next))return false;}return true;
+}
+inline AttackPhase attackPhase(const AttackSet& defs,const MeleeState& s,uint32_t tick){
+    auto it=defs.find(s.attack);if(it==defs.end()||tick<s.started)return AttackPhase::Idle;const auto& d=it->second;auto age=tick-s.started;
+    if(age<d.windup)return AttackPhase::Windup;if(age<d.windup+d.active)return AttackPhase::Active;if(age<d.windup+d.active+d.recovery)return AttackPhase::Recovery;return AttackPhase::Idle;
+}
+// Authorization includes stamina/cooldown/ownership; this helper owns only custom animation/combo timing.
+template<class Authorize>
+bool stepMelee(const AttackSet& defs,MeleeState& state,uint32_t tick,int64_t requested,Authorize authorize){
+    if(!valid(defs)||(state.attack&&!defs.contains(state.attack))||(state.queued&&!defs.contains(state.queued))||(state.initialized&&tick<=state.lastTick)||(requested&&!defs.contains(requested)))return false;
+    auto s=state;s.lastTick=tick;s.initialized=true;
+    auto phase=attackPhase(defs,s,tick);
+    if(requested){s.queued=requested;s.queuedAt=tick;}
+    auto active=defs.find(s.attack);bool canStart=phase==AttackPhase::Idle;
+    if(s.queued&&tick-s.queuedAt>defs.at(s.queued).bufferTicks)s.queued=0;
+    if(s.queued&&active!=defs.end()){
+        if(tick-s.queuedAt>active->second.bufferTicks)s.queued=0;
+        else if(tick-s.started>=active->second.cancelFrom&&std::find(active->second.combos.begin(),active->second.combos.end(),s.queued)!=active->second.combos.end())canStart=true;
+    }
+    if(s.queued&&canStart&&authorize(s.queued)){s.attack=s.queued;s.queued=0;s.started=tick;s.hitTargets.clear();}
+    else if(phase==AttackPhase::Idle){s.attack=0;s.hitTargets.clear();}
+    state=std::move(s);return true;
+}
+inline bool recordMeleeHit(const AttackSet& defs,MeleeState& s,uint32_t tick,int64_t target){
+    if(target<=0||attackPhase(defs,s,tick)!=AttackPhase::Active||s.hitTargets.size()>=4096)return false;
+    auto at=std::lower_bound(s.hitTargets.begin(),s.hitTargets.end(),target);if(at!=s.hitTargets.end()&&*at==target)return false;s.hitTargets.insert(at,target);return true;
+}
+enum class MeleeContact {Hit,Blocked,Parried,Evaded};
+inline MeleeContact resolveMeleeContact(bool invulnerable,bool parryWindow,bool blocking,bool insideGuard){
+    if(invulnerable)return MeleeContact::Evaded;if(insideGuard&&parryWindow)return MeleeContact::Parried;if(insideGuard&&blocking)return MeleeContact::Blocked;return MeleeContact::Hit;
+}
+}
diff --git a/libraries/include/rtslib/genre/Narrative.h b/libraries/include/rtslib/genre/Narrative.h
new file mode 100644
index 00000000..f97b0c88
--- /dev/null
+++ b/libraries/include/rtslib/genre/Narrative.h
@@ -0,0 +1,49 @@
+#pragma once
+#include "../systems/Tags.h"
+#include <algorithm>
+#include <limits>
+#include <map>
+#include <optional>
+#include <string>
+#include <vector>
+namespace rts::lib::genre {
+struct FactChange {int64_t key=0,value=0;bool add=false;};
+struct StoryChoice {int64_t id=0,next=0;std::string textKey;std::vector<systems::Condition> conditions;std::vector<FactChange> changes;};
+struct StoryNode {int64_t id=0;std::string textKey;std::vector<StoryChoice> choices;};
+using Story=std::map<int64_t,StoryNode>;
+struct StoryState {int64_t node=0;std::map<int64_t,int64_t> facts,visits;uint64_t lastCommand=0;bool complete=false;};
+inline bool valid(const Story& graph){
+    if(graph.empty()||graph.size()>10000)return false;
+    for(const auto& [id,node]:graph){
+        if(id<=0||node.id!=id||node.textKey.empty()||node.choices.size()>128)return false;std::vector<int64_t> ids;
+        for(const auto& choice:node.choices){
+            if(choice.id<=0||choice.textKey.empty()||(choice.next&&!graph.contains(choice.next))||std::find(ids.begin(),ids.end(),choice.id)!=ids.end())return false;ids.push_back(choice.id);
+            if(choice.changes.size()>256||choice.conditions.size()>256)return false;
+            for(auto condition:choice.conditions)if(condition.key<=0||condition.minimum>condition.maximum)return false;
+            for(auto change:choice.changes)if(change.key<=0)return false;
+        }
+    }return true;
+}
+inline std::optional<StoryState> beginStory(const Story& graph,int64_t node,std::map<int64_t,int64_t> facts={}){
+    if(!valid(graph)||!graph.contains(node)||facts.size()>10000)return {};for(auto [key,value]:facts){(void)value;if(key<=0)return {};}
+    StoryState s;s.node=node;s.facts=std::move(facts);s.visits[node]=1;return s;
+}
+inline bool choiceAllowed(const StoryChoice& choice,const StoryState& s){
+    return systems::conditions(std::span<const systems::Condition>(choice.conditions),[&](int64_t key)->std::optional<int64_t>{auto it=s.facts.find(key);if(it==s.facts.end())return {};return it->second;});
+}
+inline std::vector<int64_t> storyChoices(const Story& graph,const StoryState& s){
+    std::vector<int64_t> choices;auto node=graph.find(s.node);if(node==graph.end()||s.complete)return choices;
+    for(const auto& choice:node->second.choices)if(choiceAllowed(choice,s))choices.push_back(choice.id);std::sort(choices.begin(),choices.end());return choices;
+}
+inline bool chooseStory(const Story& graph,StoryState& state,int64_t id,uint64_t command){
+    if(!valid(graph)||state.complete||command==0||command<=state.lastCommand)return false;auto node=graph.find(state.node);if(node==graph.end())return false;
+    auto found=std::find_if(node->second.choices.begin(),node->second.choices.end(),[&](const auto& c){return c.id==id;});if(found==node->second.choices.end()||!choiceAllowed(*found,state))return false;
+    auto next=state;
+    for(auto change:found->changes){auto& value=next.facts[change.key];if(change.add){if((change.value>0&&value>std::numeric_limits<int64_t>::max()-change.value)||(change.value<0&&value<std::numeric_limits<int64_t>::min()-change.value))return false;value+=change.value;}else value=change.value;}
+    if(next.facts.size()>10000)return false;next.lastCommand=command;next.node=found->next;next.complete=found->next==0;
+    if(!next.complete){auto& count=next.visits[next.node];if(count==std::numeric_limits<int64_t>::max())return false;++count;}
+    state=std::move(next);return true;
+}
+// textKey/choice.textKey are localization keys. Camera/animation/dialogue UI consume the committed node;
+// this graph does not perform scene transitions or issue economy rewards by itself.
+}
diff --git a/libraries/include/rtslib/genre/Persistence.h b/libraries/include/rtslib/genre/Persistence.h

diff --git a/libraries/include/rtslib/Tasks.h b/libraries/include/rtslib/Tasks.h
new file mode 100644
index 00000000..8489c6a5
--- /dev/null
+++ b/libraries/include/rtslib/Tasks.h
@@ -0,0 +1,32 @@
+#pragma once
+#include <cstdint>
+#include <cstddef>
+#include <optional>
+#include <span>
+namespace rts::lib {
+enum class TaskStatus : std::int64_t { Pending,Active,Done };
+struct Task { std::int64_t id=0,priority=0,worker=0; TaskStatus status=TaskStatus::Pending; };
+// Unique task IDs; worker IDs > 0. Caller stores/restores task fields in NativeState.
+template<class Eligible>
+std::optional<std::size_t> claim(std::span<Task> tasks,std::int64_t worker,Eligible eligible) {
+    if (worker<=0) return std::nullopt;
+    for (std::size_t i=0;i<tasks.size();++i) if (tasks[i].worker==worker && tasks[i].status==TaskStatus::Active) return i;
+    std::optional<std::size_t> best;
+    for (std::size_t i=0;i<tasks.size();++i) {
+        const auto& t=tasks[i];
+        if (t.status!=TaskStatus::Pending || !eligible(t)) continue;
+        if (!best || t.priority>tasks[*best].priority || (t.priority==tasks[*best].priority && t.id<tasks[*best].id)) best=i;
+    }
+    if (best) { tasks[*best].worker=worker; tasks[*best].status=TaskStatus::Active; }
+    return best;
+}
+inline std::optional<std::size_t> claim(std::span<Task> tasks,std::int64_t worker) { return claim(tasks,worker,[](const Task&){return true;}); }
+inline void releaseWorker(std::span<Task> tasks,std::int64_t worker) {
+    if (worker<=0) return;
+    for (auto& t:tasks) if (t.worker==worker && t.status==TaskStatus::Active) { t.worker=0; t.status=TaskStatus::Pending; }
+}
+inline bool finish(Task& task,std::int64_t worker) {
+    if (worker<=0 || task.status!=TaskStatus::Active || task.worker!=worker) return false;
+    task.worker=0; task.status=TaskStatus::Done; return true;
+}
+}
diff --git a/libraries/include/rtslib/app/Balance.h b/libraries/include/rtslib/app/Balance.h
new file mode 100644
index 00000000..57d85312
--- /dev/null
+++ b/libraries/include/rtslib/app/Balance.h
@@ -0,0 +1,24 @@
+#pragma once
+#include <cstdint>
+#include <map>
+#include <string>
+#include <vector>
+namespace rts::lib::app {
+struct MatchSample { std::uint64_t seed=0,ticks=0; std::string first,second,winner; };
+struct BalanceRow { std::size_t played=0,wins=0,losses=0,draws=0; };
+// Host analysis only. Mirrored matches should use the same seed and swapped starting slots.
+inline bool addSample(std::map<std::string,BalanceRow>& report,const MatchSample& s) {
+    if(s.first.empty()||s.second.empty()||s.first==s.second||(!s.winner.empty()&&s.winner!=s.first&&s.winner!=s.second))return false;
+    auto& a=report[s.first];auto& b=report[s.second];++a.played;++b.played;
+    if(s.winner.empty()){++a.draws;++b.draws;}else if(s.winner==s.first){++a.wins;++b.losses;}else{++b.wins;++a.losses;}
+    return true;
+}
+struct MatchCase { std::string first,second;std::uint64_t seed; };
+inline std::vector<MatchCase> roundRobin(const std::vector<std::string>& factions,const std::vector<std::uint64_t>& seeds) {
+    std::map<std::string,bool> seen;
+    for(const auto& f:factions)if(f.empty()||!seen.emplace(f,true).second)return {};
+    std::vector<MatchCase> out;
+    for(std::size_t i=0;i<factions.size();++i)for(std::size_t j=i+1;j<factions.size();++j)for(auto seed:seeds){out.push_back({factions[i],factions[j],seed});out.push_back({factions[j],factions[i],seed});}
+    return out;
+}
+}
diff --git a/libraries/include/rtslib/app/Binding.h b/libraries/include/rtslib/app/Binding.h
new file mode 100644
index 00000000..4939f8c5
--- /dev/null
+++ b/libraries/include/rtslib/app/Binding.h
@@ -0,0 +1,61 @@
+#pragma once
+#include <cstdint>
+#include <map>
+#include <string>
+#include <variant>
+#include <vector>
+
+namespace rts::lib::app {
+using Value = std::variant<bool, std::int64_t, std::string>;
+struct Change { std::string key; Value value; };
+// Owns a presentation snapshot, never references mutable simulation memory.
+class BindingModel {
+    std::map<std::string, Value> values_;
+    std::map<std::string, Value> dirty_;
+public:
+    bool set(const std::string& key, Value value) {
+        if (key.empty()) return false;
+        auto it = values_.find(key);
+        if (it != values_.end() && it->second == value) return false;
+        values_.insert_or_assign(key, value);
+        dirty_.insert_or_assign(key, std::move(value));
+        return true;
+    }
+    const Value* get(const std::string& key) const {
+        auto it = values_.find(key); return it == values_.end() ? nullptr : &it->second;
+    }
+    std::vector<Change> drain() {
+        std::vector<Change> out;
+        for (const auto& [key, value] : dirty_) out.push_back({key, value});
+        dirty_.clear(); return out;
+    }
+    void invalidate() { dirty_ = values_; }
+};
+inline std::string displayValue(const Value& v) {
+    if (auto p = std::get_if<std::string>(&v)) return *p;
+    if (auto p = std::get_if<bool>(&v)) return *p ? "true" : "false";
+    return std::to_string(std::get<std::int64_t>(v));
+}
+inline std::string escapeMarkup(const std::string& text) {
+    std::string out;
+    for (char c : text) switch (c) {
+        case '&': out += "&amp;"; break; case '<': out += "&lt;"; break;
+        case '>': out += "&gt;"; break; case '\"': out += "&quot;"; break;
+        case '\'': out += "&#39;"; break; default: out += c;
+    }
+    return out;
+}
+struct Action { std::string id; std::string payload; };
+// Bounded queue avoids unbounded input growth while the host is paused.
+class Actions {
+    std::size_t capacity_;
+    std::vector<Action> pending_;
+public:
+    explicit Actions(std::size_t capacity = 128) : capacity_(capacity) {}
+    bool push(Action action) {
+        if (action.id.empty() || pending_.size() >= capacity_) return false;
+        pending_.push_back(std::move(action)); return true;
+    }
+    std::vector<Action> drain() { std::vector<Action> out; out.swap(pending_); return out; }
+};
+}
diff --git a/libraries/include/rtslib/app/Content.h b/libraries/include/rtslib/app/Content.h
new file mode 100644
index 00000000..463b4b3d
--- /dev/null
+++ b/libraries/include/rtslib/app/Content.h
@@ -0,0 +1,33 @@
+#pragma once
+#include "../Graphs.h"
+#include <algorithm>
+#include <cstdint>
+#include <map>
+#include <string>
+namespace rts::lib::app {
+struct Dependency { std::string id; std::uint32_t minimum=1, maximum=0; };
+struct ContentPackage { std::string id, digest; std::uint32_t version=1; std::vector<Dependency> dependencies; std::vector<std::string> conflicts; };
+struct ContentOrder { std::vector<std::string> ids; std::string error; explicit operator bool() const { return error.empty(); } };
+// Stable ordering independent of discovery order. Does not execute mods or read arbitrary paths.
+inline ContentOrder resolveContent(std::vector<ContentPackage> packages) {
+    std::sort(packages.begin(),packages.end(),[](const auto& a,const auto& b){return a.id<b.id;});
+    std::map<std::string,std::size_t> index;
+    for(std::size_t i=0;i<packages.size();++i) {
+        const auto& p=packages[i];
+        if(p.id.empty()||p.digest.empty()||p.version==0||!index.emplace(p.id,i).second)return {{},"invalid or duplicate package: "+p.id};
+    }
+    Graph edges(packages.size());
+    for(std::size_t i=0;i<packages.size();++i) {
+        for(const auto& conflict:packages[i].conflicts) if(index.count(conflict))return {{},"conflict: "+packages[i].id+" / "+conflict};
+        for(const auto& d:packages[i].dependencies) {
+            auto it=index.find(d.id);
+            if(it==index.end())return {{},"missing dependency: "+d.id};
+            const auto v=packages[it->second].version;
+            if(d.minimum==0||(d.maximum&&d.maximum<d.minimum)||v<d.minimum||(d.maximum&&v>d.maximum))return {{},"version mismatch: "+d.id};
+            edges[it->second].push_back(i);
+        }
+    }
+    auto order=topological(edges);if(!order)return {{},"dependency cycle"};
+    ContentOrder out;for(auto i:*order)out.ids.push_back(packages[i].id);return out;
+}
+}

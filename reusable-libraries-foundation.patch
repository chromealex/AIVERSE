diff --git a/libraries/include/rtslib/gameplay/Saves.h b/libraries/include/rtslib/gameplay/Saves.h
new file mode 100644
index 00000000..8e99d3af
--- /dev/null
+++ b/libraries/include/rtslib/gameplay/Saves.h
@@ -0,0 +1,21 @@
+#pragma once
+#include "Diagnostics.h"
+#include <cstdint>
+#include <functional>
+#include <span>
+namespace rts::lib::gameplay {
+template<class State> struct Migration { std::int64_t from=0,to=0;std::function<bool(State&)> apply; };
+// Run at load/import, before installing a state. Failure never modifies the live state.
+// Engine nativeModules VERSION compatibility is separate; this does not bypass it.
+template<class State>
+Decision migrate(State& state,std::int64_t& version,std::int64_t target,std::span<const Migration<State>> migrations) {
+    if(version<0||target<version)return {Reason::Version,0,target,version};
+    auto next=state;auto current=version;
+    while(current<target){const Migration<State>* step=nullptr;
+        for(const auto& m:migrations)if(m.from==current){if(step)return {Reason::Invalid,current};step=&m;}
+        if(!step||step->to<=current||step->to>target||!step->apply)return {Reason::Version,0,target,current};
+        if(!step->apply(next))return {Reason::Invalid,current};current=step->to;
+    }
+    state=std::move(next);version=current;return {};
+}
+}
diff --git a/libraries/include/rtslib/gameplay/Squads.h b/libraries/include/rtslib/gameplay/Squads.h
new file mode 100644
index 00000000..d5ab7fc1
--- /dev/null
+++ b/libraries/include/rtslib/gameplay/Squads.h
@@ -0,0 +1,34 @@
+#pragma once
+#include "Diagnostics.h"
+#include "Construction.h"
+#include <algorithm>
+#include <cstdint>
+#include <optional>
+#include <span>
+#include <vector>
+namespace rts::lib::gameplay {
+struct Member { std::int64_t id=0,role=0,leaderPriority=0;bool alive=true; };
+inline std::optional<std::int64_t> selectLeader(std::span<const Member> members) {
+    const Member* best=nullptr;for(const auto& m:members)if(m.alive&&(!best||m.leaderPriority>best->leaderPriority||(m.leaderPriority==best->leaderPriority&&m.id<best->id)))best=&m;
+    return best?std::optional(best->id):std::nullopt;
+}
+enum class Formation { Line,Box,Wedge,Loose };
+struct AssignedSlot { std::int64_t entity=0;Cell offset; };
+inline std::optional<std::vector<AssignedSlot>> formationSlots(std::span<const Member> members,Formation shape,std::int64_t spacing,std::int64_t columns=4) {
+    if(spacing<1||spacing>1000000||columns<1||columns>65536||members.size()>65536)return std::nullopt;
+    std::vector<Member> alive;for(auto m:members)if(m.alive)alive.push_back(m);
+    std::sort(alive.begin(),alive.end(),[](auto a,auto b){return a.role!=b.role?a.role<b.role:a.id<b.id;});
+    std::vector<std::int64_t> ids;for(auto m:alive)ids.push_back(m.id);std::sort(ids.begin(),ids.end());
+    if(std::adjacent_find(ids.begin(),ids.end())!=ids.end())return std::nullopt;
+    std::vector<AssignedSlot> out;
+    for(std::size_t i=0;i<alive.size();++i){auto n=static_cast<std::int64_t>(i);Cell p;
+        switch(shape){
+        case Formation::Line:p={n*spacing,0};break;
+        case Formation::Box:p={(n%columns)*spacing,(n/columns)*spacing};break;
+        case Formation::Wedge:p={(n%2?1:-1)*((n+1)/2)*spacing,((n+1)/2)*spacing};break;
+        case Formation::Loose:p={(n%columns)*spacing*2+(n/columns%2)*spacing,(n/columns)*spacing*2};break;
+        default:return std::nullopt;
+        }out.push_back({alive[i].id,p});
+    }return out;
+}
+}
diff --git a/libraries/include/rtslib/gameplay/Tutorial.h b/libraries/include/rtslib/gameplay/Tutorial.h
new file mode 100644
index 00000000..3debc27e
--- /dev/null
+++ b/libraries/include/rtslib/gameplay/Tutorial.h
@@ -0,0 +1,29 @@
+#pragma once
+#include "Diagnostics.h"
+#include <algorithm>
+#include <cstdint>
+#include <span>
+#include <vector>
+namespace rts::lib::gameplay {
+struct TutorialStep { std::int64_t id=0,event=0,target=1,next=-1,highlight=0;bool allowSkip=true;std::vector<std::int64_t> blockedActions; };
+struct TutorialState { std::int64_t step=0,progress=0;bool complete=false; };
+inline const TutorialStep* findStep(std::span<const TutorialStep> steps,std::int64_t id){for(const auto& s:steps)if(s.id==id)return &s;return nullptr;}
+inline Decision validateTutorial(std::span<const TutorialStep> steps) {
+    for(std::size_t i=0;i<steps.size();++i){const auto& s=steps[i];if(s.id<0||s.target<1||(s.next!=-1&&!findStep(steps,s.next)))return {Reason::Invalid,s.id};
+        for(std::size_t j=0;j<i;++j)if(steps[j].id==s.id)return {Reason::Invalid,s.id};}
+    return {};
+}
+inline Decision tutorialEvent(std::span<const TutorialStep> steps,TutorialState& state,std::int64_t event,bool skip=false) {
+    if(state.complete)return {};auto s=findStep(steps,state.step);
+    if(!s||s->target<1||state.progress<0||(s->next!=-1&&!findStep(steps,s->next)))return {Reason::Invalid,state.step};
+    if(skip&&!s->allowSkip)return {Reason::Blocked,s->id};
+    if(!skip&&s->event!=event)return {};
+    auto next=state;if(skip)next.progress=s->target;else if(next.progress<s->target)++next.progress;
+    if(next.progress>=s->target){next.progress=0;if(s->next==-1)next.complete=true;else next.step=s->next;}
+    state=next;return {};
+}
+inline bool tutorialAllows(std::span<const TutorialStep> steps,const TutorialState& state,std::int64_t action,bool hard) {
+    if(!hard||state.complete)return true;auto s=findStep(steps,state.step);if(!s)return false;
+    return std::find(s->blockedActions.begin(),s->blockedActions.end(),action)==s->blockedActions.end();
+}
+}

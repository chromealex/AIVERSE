diff --git a/libraries/include/rtslib/Behavior.h b/libraries/include/rtslib/Behavior.h
new file mode 100644
index 00000000..2d76eb37
--- /dev/null
+++ b/libraries/include/rtslib/Behavior.h
@@ -0,0 +1,25 @@
+#pragma once
+#include <cstdint>
+#include <optional>
+#include <span>
+#include <type_traits>
+#include <utility>
+namespace rts::lib {
+struct Transition { std::int64_t from,event,to; };
+// Definitions must have unique (from,event); declared first match wins.
+inline bool transition(std::int64_t& current,std::span<const Transition> definitions,std::int64_t event) {
+    for (const auto& t:definitions) if (t.from==current && t.event==event) { current=t.to; return true; }
+    return false;
+}
+template<class Score>
+std::optional<std::int64_t> choose(std::span<const std::int64_t> candidates,Score score) {
+    using Value=std::remove_cvref_t<decltype(score(std::int64_t{}))>;
+    static_assert(!std::is_floating_point_v<Value>,"simulation scores must be integer or Fixed");
+    std::optional<std::int64_t> best; std::optional<Value> bestScore;
+    for (auto id:candidates) {
+        auto value=score(id);
+        if (!best || value>*bestScore || (value==*bestScore && id<*best)) { best=id; bestScore=value; }
+    }
+    return best;
+}
+}
diff --git a/libraries/include/rtslib/Collections.h b/libraries/include/rtslib/Collections.h
new file mode 100644
index 00000000..a3afd363
--- /dev/null
+++ b/libraries/include/rtslib/Collections.h
@@ -0,0 +1,35 @@
+#pragma once
+#include <algorithm>
+#include <cstddef>
+#include <deque>
+#include <numeric>
+#include <optional>
+#include <span>
+#include <utility>
+#include <type_traits>
+#include <vector>
+
+namespace rts::lib {
+// Transient storage; persist gameplay queues through the host's state container.
+template<class T> class Queue {
+public:
+    void push(T value) { items_.push_back(std::move(value)); }
+    std::optional<T> pop() {
+        if (items_.empty()) return std::nullopt;
+        T value=std::move(items_.front()); items_.pop_front(); return value;
+    }
+    bool empty() const { return items_.empty(); }
+private:
+    std::deque<T> items_;
+};
+// Return indices; ties preserve input order. Score must be pure and deterministic.
+template<class T, class Score>
+std::vector<std::size_t> topIndices(std::span<const T> items, std::size_t count, Score score) {
+    using Value=std::remove_cvref_t<decltype(score(std::declval<const T&>()))>;
+    static_assert(!std::is_floating_point_v<Value>,"simulation scores must be integer or Fixed");
+    std::vector<std::size_t> indices(items.size());
+    std::iota(indices.begin(),indices.end(),0);
+    std::stable_sort(indices.begin(),indices.end(),[&](auto a,auto b){ return score(items[a])>score(items[b]); });
+    indices.resize(std::min(count,indices.size())); return indices;
+}
+}
diff --git a/libraries/include/rtslib/Graphs.h b/libraries/include/rtslib/Graphs.h
new file mode 100644
index 00000000..ae5ac76c
--- /dev/null
+++ b/libraries/include/rtslib/Graphs.h
@@ -0,0 +1,43 @@
+#pragma once
+#include <cstddef>
+#include <optional>
+#include <queue>
+#include <functional>
+#include <vector>
+#include <limits>
+
+namespace rts::lib {
+using Graph = std::vector<std::vector<std::size_t>>;
+inline constexpr std::size_t kUnreachable=std::numeric_limits<std::size_t>::max();
+struct BfsResult { std::vector<std::size_t> distance,parent; };
+inline bool validGraph(const Graph& edges) {
+    for (const auto& row:edges) for (auto v:row) if (v>=edges.size()) return false;
+    return true;
+}
+inline std::optional<BfsResult> bfs(const Graph& edges,std::size_t start) {
+    if (start>=edges.size() || !validGraph(edges)) return std::nullopt;
+    BfsResult result{std::vector<std::size_t>(edges.size(),kUnreachable),std::vector<std::size_t>(edges.size(),kUnreachable)};
+    std::vector<std::size_t> queue{start}; result.distance[start]=0;
+    for (std::size_t head=0;head<queue.size();++head) {
+        const auto u=queue[head];
+        for (auto v:edges[u]) if (result.distance[v]==kUnreachable) {
+            result.distance[v]=result.distance[u]+1; result.parent[v]=u; queue.push_back(v);
+        }
+    }
+    return result;
+}
+// Nullopt means malformed edges or a cycle; empty graph has an empty ordering.
+inline std::optional<std::vector<std::size_t>> topological(const Graph& edges) {
+    if (!validGraph(edges)) return std::nullopt;
+    std::vector<std::size_t> degree(edges.size()),result;
+    for (const auto& row:edges) for (auto v:row) ++degree[v];
+    std::priority_queue<std::size_t,std::vector<std::size_t>,std::greater<std::size_t>> ready;
+    for (std::size_t i=0;i<degree.size();++i) if (degree[i]==0) ready.push(i);
+    while (!ready.empty()) {
+        auto u=ready.top(); ready.pop(); result.push_back(u);
+        for (auto v:edges[u]) if (--degree[v]==0) ready.push(v);
+    }
+    if (result.size()!=edges.size()) return std::nullopt;
+    return result;
+}
+}
diff --git a/libraries/include/rtslib/Grid.h b/libraries/include/rtslib/Grid.h
new file mode 100644
index 00000000..26216071
--- /dev/null
+++ b/libraries/include/rtslib/Grid.h
@@ -0,0 +1,27 @@
+#pragma once
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+#include <span>
+#include <vector>
+namespace rts::lib {
+// Row-major, zero-based IDs. Four neighbors; -1 means blocked/unreachable.
+inline std::optional<std::vector<std::int32_t>> gridDistance(
+    std::size_t width,std::size_t height,std::span<const std::uint8_t> passable,
+    std::span<const std::size_t> seeds) {
+    if (!width || !height || width>4096 || height>4096 || width*height>262144 || passable.size()!=width*height) return std::nullopt;
+    const auto count=width*height;
+    for (auto seed:seeds) if (seed>=count) return std::nullopt;
+    std::vector<std::int32_t> distance(count,-1); std::vector<std::size_t> queue;
+    for (auto seed:seeds) if (passable[seed] && distance[seed]<0) { distance[seed]=0; queue.push_back(seed); }
+    for (std::size_t head=0;head<queue.size();++head) {
+        auto u=queue[head];
+        auto visit=[&](std::size_t v){ if (passable[v] && distance[v]<0) { distance[v]=distance[u]+1; queue.push_back(v); } };
+        if (u%width>0) visit(u-1);
+        if (u%width+1<width) visit(u+1);
+        if (u>=width) visit(u-width);
+        if (u<count-width) visit(u+width);
+    }
+    return distance;
+}
+}
diff --git a/libraries/include/rtslib/Logistics.h b/libraries/include/rtslib/Logistics.h
new file mode 100644
index 00000000..ed764783
--- /dev/null
+++ b/libraries/include/rtslib/Logistics.h
@@ -0,0 +1,20 @@
+#pragma once
+#include <cstdint>
+#include <cstddef>
+#include <limits>
+#include <span>
+#include <vector>
+namespace rts::lib {
+struct Ingredient { std::size_t resource; std::int64_t amount; };
+// Validate and aggregate before mutation, including duplicate ingredients.
+inline bool consume(std::span<std::int64_t> stock,std::span<const Ingredient> recipe) {
+    std::vector<std::int64_t> needed(stock.size());
+    for (const auto& r:recipe) {
+        if (r.resource>=stock.size() || r.amount<0 || r.amount>std::numeric_limits<std::int64_t>::max()-needed[r.resource]) return false;
+        needed[r.resource]+=r.amount;
+    }
+    for (std::size_t i=0;i<stock.size();++i) if (needed[i]>0 && stock[i]<needed[i]) return false;
+    for (std::size_t i=0;i<stock.size();++i) if (needed[i]>0) stock[i]-=needed[i];
+    return true;
+}
+}

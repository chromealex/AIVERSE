+++ b/libraries/CMakeLists.txt
@@ -0,0 +1,51 @@
+# Public header-only algorithms: usable by native project modules and standalone hosts.
+add_library(rts_libraries INTERFACE)
+add_library(RTSEngine::libraries ALIAS rts_libraries)
+target_compile_features(rts_libraries INTERFACE cxx_std_20)
+target_include_directories(rts_libraries INTERFACE "${CMAKE_CURRENT_LIST_DIR}/include")
+# Optional engine adapter includes native Command types. Pure gameplay headers remain standalone.
+add_library(rts_gameplay_native INTERFACE)
+add_library(RTSEngine::gameplay_native ALIAS rts_gameplay_native)
+target_link_libraries(rts_gameplay_native INTERFACE RTSEngine::libraries)
+target_include_directories(rts_gameplay_native INTERFACE "${CMAKE_CURRENT_LIST_DIR}/..")
+
+# Genre bot adapters are available before an external game's native/CMakeLists.txt executes.
+add_library(rts_rts_bots INTERFACE)
+add_library(RTSEngine::rts_bots ALIAS rts_rts_bots)
+target_link_libraries(rts_rts_bots INTERFACE RTSEngine::gameplay_native rts_game)
+add_library(rts_fps_bots INTERFACE)
+add_library(RTSEngine::fps_bots ALIAS rts_fps_bots)
+target_link_libraries(rts_fps_bots INTERFACE RTSEngine::gameplay_native rts_fps)
+
+add_library(rts_navmesh_library INTERFACE)
+add_library(RTSEngine::navmesh ALIAS rts_navmesh_library)
+target_link_libraries(rts_navmesh_library INTERFACE RTSEngine::gameplay_native rts_world)
+
+# OBJECT native modules are inserted with TARGET_OBJECTS: their PRIVATE link requirements do not
+# propagate. Put backend libraries on the owning game target, avoiding a native -> rts_game cycle.
+function(rts_native_use_bots target)
+    if(NOT TARGET ${target} OR NOT TARGET rts_game)
+        message(FATAL_ERROR "rts_native_use_bots requires a registered native target")
+    endif()
+    target_link_libraries(${target} PRIVATE RTSEngine::gameplay_native)
+    foreach(genre IN LISTS ARGN)
+        if(genre STREQUAL "FPS")
+            target_link_libraries(rts_game PUBLIC rts_fps)
+        elseif(genre STREQUAL "NAVMESH")
+            target_link_libraries(rts_game PUBLIC rts_world)
+        elseif(NOT genre STREQUAL "RTS")
+            message(FATAL_ERROR "rts_native_use_bots: expected RTS, FPS or NAVMESH")
+        endif()
+    endforeach()
+endfunction()
+
+add_library(rts_genre_library INTERFACE)
+add_library(RTSEngine::genre ALIAS rts_genre_library)
+target_link_libraries(rts_genre_library INTERFACE RTSEngine::gameplay_native rts_world)
+function(rts_native_use_genre target)
+    if(NOT TARGET ${target} OR NOT TARGET rts_game)
+        message(FATAL_ERROR "rts_native_use_genre requires a registered native target")
+    endif()
+    target_link_libraries(${target} PRIVATE RTSEngine::gameplay_native)
+    target_link_libraries(rts_game PUBLIC rts_world)
+endfunction()
diff --git a/libraries/adapters/rmlui/ScreenBinding.h b/libraries/adapters/rmlui/ScreenBinding.h
new file mode 100644
index 00000000..819b0811
--- /dev/null
+++ b/libraries/adapters/rmlui/ScreenBinding.h
@@ -0,0 +1,45 @@
+#pragma once
+#include <RmlUi/Core/Element.h>
+#include <RmlUi/Core/Event.h>
+#include <RmlUi/Core/EventListener.h>
+#include <rtslib/app/Screens.h>
+namespace rts::lib::app {
+// Root must outlive this binding. Destroy bindings before closing/reloading the document.
+// Retain one root per screen; replacing children does not invalidate the root listener.
+class RmlScreenBinding final : public Rml::EventListener {
+    Rml::Element& root_;
+    ScreenStack& stack_;
+    Actions& actions_;
+    std::string screenId_;
+public:
+    RmlScreenBinding(Rml::Element& root,ScreenStack& stack,Actions& actions,std::string screenId)
+        :root_(root),stack_(stack),actions_(actions),screenId_(std::move(screenId)) {root_.AddEventListener("click",this);}
+    ~RmlScreenBinding() override {root_.RemoveEventListener("click",this);stack_.close(screenId_);}
+    RmlScreenBinding(const RmlScreenBinding&)=delete;
+    RmlScreenBinding& operator=(const RmlScreenBinding&)=delete;
+    template<class Translate> bool show(Screen screen,Translate translate) {
+        if(screen.id!=screenId_||!validScreen(screen))return false;
+        const auto markup=screenMarkup(screen,translate);
+        if(!stack_.open(std::move(screen)))return false;
+        root_.SetInnerRML(markup);return true;
+    }
+    void ProcessEvent(Rml::Event& event) override {
+        auto* element=event.GetTargetElement();
+        while(element&&element!=&root_){
+            auto action=stack_.click(screenId_,element->GetId());
+            if(action){actions_.push(std::move(*action));event.StopPropagation();return;}
+            element=element->GetParentNode();
+        }
+    }
+};
+// Map snapshot keys to element IDs. Text is escaped, never evaluated as markup.
+inline std::vector<std::string> applyBindings(Rml::Element& root,const std::vector<Change>& changes) {
+    std::vector<std::string> missing;
+    for(const auto& change:changes){
+        auto* element=root.GetElementById(change.key);
+        if(!element){missing.push_back(change.key);continue;}
+        element->SetInnerRML(escapeMarkup(displayValue(change.value)));
+    }
+    return missing;
+}
+}

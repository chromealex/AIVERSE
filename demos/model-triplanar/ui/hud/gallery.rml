<rml><head><title>Triplanar material</title><link type="text/rcss" href="../theme.rcss"/>
<style>body{pointer-events:none;} .controls{position:absolute;left:18dp;top:18dp;padding:12dp;background-color:#20252bea;color:#fff;pointer-events:auto;}button{margin-right:4dp;}</style>
</head><body><div class="controls" data-model="script"><button data-event-click="event('front')">Front</button><button data-event-click="event('side')">Side</button><button data-event-click="event('wide')">Zoom out</button></div></body></rml>

<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Linked into every AIVERSE executable on Windows (CMakeLists.txt, aiverse_utf8_manifest).
     activeCodePage UTF-8 (Windows 10 1903+): the process ANSI code page is UTF-8, so the engine's
     UTF-8 std::string paths work with fopen / std::fstream / std::filesystem / getenv / argv, and
     project folders or files with non-ASCII names (e.g. Cyrillic) open on Windows as on macOS/Linux. -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>

# Pure CMake: exported projects and offline builds do not need Python or network access.
cmake_minimum_required(VERSION 3.22)
if(NOT DEFINED AIVERSE_NOTICE_ROOT OR NOT DEFINED AIVERSE_NOTICE_OUTPUT)
    message(FATAL_ERROR "AIVERSE_NOTICE_ROOT and AIVERSE_NOTICE_OUTPUT are required")
endif()
file(READ "${AIVERSE_NOTICE_ROOT}/third_party/notices.json" manifest)
string(JSON count LENGTH "${manifest}" entries)
math(EXPR last "${count} - 1")
set(text "AIVERSE - third-party notices\n\nThis distribution uses AIVERSE and may include the components below.\nThis conservative inventory also retains notices for optional and build-time\ncomponents; inclusion here does not mean a component is linked into this game.\nZstandard is used under its BSD option; Monocypher under BSD-2-Clause.\nThe game's own code and assets retain their respective licenses.\n")
foreach(i RANGE 0 ${last})
    string(JSON name GET "${manifest}" entries ${i} name)
    string(JSON path GET "${manifest}" entries ${i} path)
    set(source "${AIVERSE_NOTICE_ROOT}/${path}")
    if(NOT EXISTS "${source}" OR IS_DIRECTORY "${source}")
        message(FATAL_ERROR "Missing license source: ${path}")
    endif()
    file(READ "${source}" license)
    string(JSON offset ERROR_VARIABLE no_slice GET "${manifest}" entries ${i} offset)
    if(NOT no_slice)
        string(JSON length GET "${manifest}" entries ${i} length)
        string(JSON expected GET "${manifest}" entries ${i} sha256)
        string(SHA256 actual "${license}")
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "License source changed: ${path}. Re-audit its embedded notice in third_party/notices.json.")
        endif()
        string(SUBSTRING "${license}" ${offset} ${length} license)
    endif()
    string(STRIP "${license}" nonempty)
    if(nonempty STREQUAL "")
        message(FATAL_ERROR "Empty license: ${path}")
    endif()
    string(APPEND text "\n================================================================\n${name}\nSource: ${path}\n================================================================\n\n${license}\n")
endforeach()
set(extras "${AIVERSE_PROJECT_NOTICES}" "${AIVERSE_PLUGIN_NOTICES}")
list(APPEND extras ${AIVERSE_TOOLCHAIN_NOTICES})
foreach(extra IN LISTS extras)
    if(NOT extra STREQUAL "")
        if(NOT EXISTS "${extra}" OR IS_DIRECTORY "${extra}")
            message(FATAL_ERROR "Missing additional notices: ${extra}")
        endif()
        file(READ "${extra}" license)
        string(STRIP "${license}" nonempty)
        if(nonempty STREQUAL "")
            message(FATAL_ERROR "Empty additional notices: ${extra}")
        endif()
        string(APPEND text "\n================================================================\nAdditional game / SDK notices\n================================================================\n\n${license}\n")
    endif()
endforeach()
get_filename_component(output_dir "${AIVERSE_NOTICE_OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${output_dir}")
# Avoid changing timestamps on identical rebuilds.
set(previous "")
if(EXISTS "${AIVERSE_NOTICE_OUTPUT}")
    file(READ "${AIVERSE_NOTICE_OUTPUT}" previous)
endif()
if(NOT previous STREQUAL text)
    file(WRITE "${AIVERSE_NOTICE_OUTPUT}" "${text}")
endif()

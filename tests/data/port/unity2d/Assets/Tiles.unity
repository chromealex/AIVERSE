%YAML 1.1
--- !u!1 &1
GameObject:
  m_Name: Tilemap
--- !u!4 &2
Transform:
  m_GameObject: {fileID: 1}
  m_Father: {fileID: 0}
  m_LocalPosition: {x: 0, y: 0, z: 0}
  m_LocalRotation: {x: 0, y: 0, z: 0, w: 1}
  m_LocalScale: {x: 1, y: 1, z: 1}
--- !u!1839735485 &3
Tilemap:
  m_GameObject: {fileID: 1}
  m_TileAssetArray:
  - m_Data: {fileID: 1, guid: bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb, type: 2}
  m_Tiles:
  - first: {x: -1, y: 2, z: 0}
    second:
      m_TileIndex: 0
--- !u!1 &10
GameObject:
  m_Name: Sprite
--- !u!4 &11
Transform:
  m_GameObject: {fileID: 10}
  m_Father: {fileID: 0}
  m_LocalPosition: {x: 2, y: 3, z: 0}
  m_LocalRotation: {x: 0, y: 0, z: 0, w: 1}
  m_LocalScale: {x: 1, y: 1, z: 1}
--- !u!212 &12
SpriteRenderer:
  m_GameObject: {fileID: 10}
  m_Sprite: {fileID: 21300000, guid: aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa, type: 3}

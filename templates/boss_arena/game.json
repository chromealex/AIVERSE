// Boss fight sample: rules "topDown" (hero) + rules "encounters" (boss, telegraphs, statuses, mobs); see docs/encounters.md.
{
  "name": "Golem Pit",
  "id": "com.rtsengine.golempit",
  "version": "0.1.0",
  "build": 1,
  "module": "rts",
  "sourceLanguage": "en",
  "languages": ["en"],
  "rules": "rules.json",
  "maps": [ { "file": "maps/pit.json", "title": "Golem Pit (hero vs boss)" } ],
  "lighting": { "time": 0.45, "clouds": 0.2 },
  "orientation": "landscape",
  "topDown": {
    "touchControls": "auto",
    "mouseAim": "hold",
    "joystick": { "mode": "floating", "radius": 64, "deadzone": 0.12, "area": [0, 0.3, 0.5, 1], "center": [0.14, 0.78] },
    "aimStick": { "enabled": true, "mode": "floating", "radius": 56, "deadzone": 0.2, "area": [0.5, 0.3, 1, 1], "center": [0.8, 0.78] },
    "buttons": [ { "ability": "missile", "key": "Q", "anchor": [1, 1], "offset": [-70, -170], "radius": 32 } ],
    "camera": { "pitch": 60, "yaw": 0, "distance": 24, "minDistance": 14, "maxDistance": 34, "smoothing": 6,
                "lookAhead": 2.5, "aimLookAhead": 1.5, "lookAheadSmoothing": 3, "lockOffsetIfNoInput": true, "bounds": true, "margin": 4 }
  }
}

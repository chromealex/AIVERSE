<rml>
<head>
    <title>wiz_hint</title>
    <link type="text/rcss" href="../theme.rcss"/>
    <link type="text/rcss" href="../skin.rcss"/>
    <style>
        body { width: 100%; height: 100%; pointer-events: none; }
        #hint { position: absolute; left: 50%; top: 70dp; width: 380dp; max-width: 90%; margin-left: -190dp;
                padding: 8dp 12dp; pointer-events: auto; }
        #hint .title { font-weight: bold; margin-bottom: 3dp; }
        #hint .row { display: flex; justify-content: flex-end; margin-top: 6dp; }
        #hint button { margin-left: 8dp; }
    </style>
</head>
<!-- Game wizard kit: one soft-tutorial hint (scripts/view/wizard/hints.lua). -->
<body>
<div class="root" data-model="script">
    <div id="hint" class="panel">
        <div class="title">{{hint.title}}</div>
        <div>{{hint.text}}</div>
        <div class="row">
            <button class="secondary" data-event-click="event('wiz_hints_off')">@wiz.hint.off</button>
            <button data-event-click="event('wiz_hint_close')">@wiz.hint.ok</button>
        </div>
    </div>
</div>
</body>
</rml>

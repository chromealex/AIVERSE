// "Scrapyard Arena": a top-down twin-stick sample (Drone Fall style) built from data: each side flies one hero
// drone with a virtual joystick / WASD, auto-fire picks the nearest target in range, an aim stick or the mouse
// snaps shots inside a 15 degree cone, and a missile button fires along the aim. Turrets and crawlers are plain
// RTS units. Destroy the enemy core and turrets. Reference: docs/game-format.md § Top-down heroes.
{
  "victory": "noStructures",
  "resources": { "scrap": { "name": "Scrap", "kind": "stock", "start": 0 } },
  "fogOfWar": { "mode": "explored" },

  "topDown": {
    "heroes": ["drone"],
    "respawn": 8,
    "move": { "accel": 36, "decel": 54, "turnRate": 720, "collideUnits": true },
    "input": { "sectors": 45, "magnitudeSteps": 1, "deadzone": 0.05 },
    "aim": { "snapCone": 15, "fires": true },
    "autoFire": { "enabled": true, "whileMoving": false, "cone": 360, "lineOfFire": true,
                  "retarget": "nearest", "interval": 0.2, "switchMargin": 0.5, "preferArmed": true, "priority": ["drone"] }
  },

  "types": {
    "drone": {
      "name": "Drone",
      "health": { "max": 650, "regen": 4 },
      "move": { "speed": 6, "radius": 0.45 },
      "sight": 11,
      "weapons": [ { "id": "blaster", "range": 6, "damage": 14, "cooldown": 0.3, "projectileSpeed": 24 } ],
      "abilities": [ { "id": "missile", "name": "Missile", "target": "point", "range": 8, "cooldown": 5, "autocast": false,
                       "effects": [ { "type": "damage", "amount": 90, "radius": 2 } ] } ],
      "view": { "shape": "flyer", "scale": 0.9 }
    },
    "crawler": {
      "name": "Crawler",
      "health": { "max": 160 },
      "move": { "speed": 2.4, "radius": 0.35 },
      "sight": 8,
      "weapons": [ { "id": "claw", "range": 0.5, "damage": 9, "cooldown": 1.0 } ],
      "view": { "shape": "soldier", "scale": 0.8 }
    },
    "turret": {
      "name": "Turret",
      "structure": { "footprint": [1, 1] },
      "health": { "max": 520, "armor": 1 },
      "sight": 8,
      "weapons": [ { "id": "cannon", "range": 5, "damage": 11, "cooldown": 1.0, "projectileSpeed": 16 } ],
      "view": { "shape": "tower", "scale": 0.8 }
    },
    "core": {
      "name": "Core",
      "structure": { "footprint": [2, 2] },
      "health": { "max": 1000, "armor": 2 },
      "sight": 9,
      "view": { "shape": "base", "scale": 0.9 }
    }
  }
}
